#!/usr/bin/env python3
"""NebulaOS Admin — the maintainer's control panel. NOT part of the ISO.

Install on your own NebulaOS only:   sudo install -m755 tools/admin/nebula-admin /usr/local/bin/
Your secret key (~/.config/nebulaos/admin.key) signs everything published here;
every NebulaOS trusts only that signature, so a copy of this program is useless
without the key. Never publish the key, keep a backup.

    Dashboard   downloads, stars, users online, versions, modes, languages
    News        announcements with an action button (update, open chat…)
    Polls       questions to all users and live results
    Community   official groups, pinned message, ban list
    Support     your Nebula ID as the support contact
    Wallpaper   wallpaper of the week for everyone
    Release     publish an update, hold back a broken one, build the ISO
    Keys        signing key and the repository copy
"""
import hashlib
import json
import os
import shlex
import shutil
import subprocess
import sys
import time
import urllib.request
from collections import Counter
from pathlib import Path

sys.path.insert(0, "/usr/lib/nebulaos")
from nebula_qt import _, Page, app, background, fit, in_terminal, tile  # noqa: E402
import nebula_sign  # noqa: E402
from PySide6.QtCore import QSize, Qt  # noqa: E402
from PySide6.QtGui import QFont  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QComboBox, QFileDialog, QFrame, QGridLayout, QHBoxLayout, QInputDialog, QLabel, QLineEdit, QListWidget,
    QListWidgetItem, QMainWindow, QMessageBox, QPlainTextEdit, QPushButton, QStackedWidget, QVBoxLayout, QWidget,
)

REPO = "matvijaskiv-svg/NebulaOS"                    # source (can be private)
UPDATES = "matvijaskiv-svg/NebulaOS-updates"         # public: what systems download
RAW = f"https://raw.githubusercontent.com/{UPDATES}/main"
CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "nebulaos"
KEY = Path(os.environ.get("NEBULA_ADMIN_KEY", CONF / "admin.key"))
COMMUNITY = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "nebula-chat/community.json"


def load_conf():
    try:
        return json.loads((CONF / "admin.json").read_text())
    except (OSError, ValueError):
        return {"checkout": str(Path.home() / "NebulaOS")}


def github(path, repo=UPDATES):
    req = urllib.request.Request(f"https://api.github.com/repos/{repo}{path}",
                                 headers={"Accept": "application/vnd.github+json", "User-Agent": "nebulaos-admin"})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.loads(r.read().decode())


def fetch_stats():
    repo = github("")
    rows = [(r.get("tag_name", "?"), sum(a.get("download_count", 0) for a in r.get("assets", [])),
             r.get("published_at", "")[:10]) for r in github("/releases?per_page=30")]
    return {"stars": repo.get("stargazers_count", 0), "forks": repo.get("forks_count", 0),
            "issues": repo.get("open_issues_count", 0), "releases": rows}


def community():
    try:
        return json.loads(COMMUNITY.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def big_number(value, label, color):
    card = QFrame()
    card.setObjectName("group")
    v = QVBoxLayout(card)
    v.setContentsMargins(16, 12, 16, 12)
    num = QLabel(str(value))
    f = QFont(num.font())
    f.setPointSizeF(f.pointSizeF() * 2.1)
    f.setBold(True)
    num.setFont(f)
    num.setStyleSheet(f"color: {color};")
    v.addWidget(num)
    t = QLabel(_(label))
    t.setStyleSheet("color: palette(placeholder-text);")
    v.addWidget(t)
    return card


def bars(group, counts, width=380):
    top = max(counts.values() or [1]) or 1
    for name, n in counts.most_common(10):
        row = QWidget()
        h = QHBoxLayout(row)
        h.setContentsMargins(0, 3, 0, 3)
        label = QLabel(str(name) or "?")
        label.setFixedWidth(120)
        bar = QFrame()
        bar.setFixedSize(max(4, int(width * n / top)), 10)
        bar.setStyleSheet("background: palette(highlight); border-radius: 5px;")
        h.addWidget(label)
        h.addWidget(bar)
        h.addStretch(1)
        h.addWidget(QLabel(str(n)))
        group.widget(row)


class Admin(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(_("NebulaOS Admin"))
        self.conf = load_conf()
        self.stats = None
        self.nav = QListWidget()
        self.nav.setObjectName("nav")
        self.nav.setFixedWidth(210)
        self.nav.setIconSize(QSize(24, 24))
        self.stack = QStackedWidget()
        self.pages = [("Dashboard", "view-statistics", "#6366f1", self.page_dashboard),
                      ("News", "mail-message-new", "#f59e0b", self.page_news),
                      ("Polls", "office-chart-bar", "#0ea5e9", self.page_polls),
                      ("Community", "system-users", "#8b5cf6", self.page_community),
                      ("Support", "help-contents", "#16a34a", self.page_support),
                      ("Wallpaper", "preferences-desktop-wallpaper", "#06b6d4", self.page_wallpaper),
                      ("Release", "document-send", "#ec4899", self.page_release),
                      ("Keys", "dialog-password", "#64748b", self.page_keys)]
        for title, icon, color, _b in self.pages:
            self.nav.addItem(QListWidgetItem(tile(icon, color), _(title)))
            self.stack.addWidget(QWidget())
        self.nav.currentRowChanged.connect(self.show_page)
        body = QWidget()
        lay = QHBoxLayout(body)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)
        lay.addWidget(self.nav)
        lay.addWidget(self.stack, 1)
        self.setCentralWidget(body)
        self.nav.setCurrentRow(0 if self.ready(quiet=True) else 7)
        background(fetch_stats, self.got_stats)
        fit(self, 1000, 700)

    # ---------- plumbing ----------
    @property
    def checkout(self):
        return Path(self.conf.get("checkout", ""))

    def ready(self, quiet=False):
        """Checkout present and the key matches the public key shipped in NebulaOS."""
        problem = None
        if not (self.checkout / ".git").exists():
            problem = _("Get the NebulaOS repository first (Keys page).")
        elif not KEY.exists():
            problem = _("Your signing key is missing (Keys page).")
        else:
            pub = (self.checkout / "desktop/usr/share/nebulaos/admin.pub").read_text().strip()
            if not nebula_sign.verify(pub, b"check", nebula_sign.sign(KEY.read_text().strip(), b"check")):
                problem = _("This key does not match admin.pub in the repository.")
        if problem and not quiet:
            QMessageBox.warning(self, _("NebulaOS Admin"), problem)
            self.nav.setCurrentRow(7)
        return problem is None

    def channel(self):
        try:
            return json.loads((self.checkout / "channel/channel.json").read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return {}

    def publish(self, data, message, extra=()):
        """Write, sign and push the channel. Every NebulaOS picks it up within 6 hours."""
        if not self.ready():
            return False
        for k, v in (("support_id", ""), ("latest", ""), ("news", []), ("polls", []), ("groups", []),
                     ("banned", []), ("blocked_versions", [])):
            data.setdefault(k, v)
        data["updated"] = int(time.time())
        text = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
        secret = KEY.read_text().strip()
        for d in (self.checkout / "channel", self.checkout / "desktop/usr/share/nebulaos"):
            d.mkdir(parents=True, exist_ok=True)
            (d / "channel.json").write_text(text, encoding="utf-8")
            (d / "channel.sig").write_text(nebula_sign.sign(secret, text.encode()) + "\n")
        files = " ".join(shlex.quote(x) for x in ["channel", "desktop/usr/share/nebulaos/channel.json",
                                                  "desktop/usr/share/nebulaos/channel.sig", *extra])
        in_terminal("bash", "-c", f"cd {shlex.quote(str(self.checkout))} && git add {files} && "
                    f"git commit -m {shlex.quote(message)} && git push && bash tools/push-updates.sh channel")
        return True

    def show_page(self, row):
        old = self.stack.widget(row)
        self.stack.insertWidget(row, self.pages[row][3]())
        self.stack.removeWidget(old)
        old.deleteLater()
        self.stack.setCurrentIndex(row)

    def reload(self):
        self.show_page(self.nav.currentRow())

    def got_stats(self, stats):
        self.stats = stats
        if self.nav.currentRow() == 0:
            self.reload()

    # ---------- Dashboard ----------
    def page_dashboard(self):
        p = Page("Dashboard", "github.com/" + UPDATES)
        com = community().get("community", {})
        now = time.time()
        online = sum(1 for u in com.values() if now - u.get("seen", 0) < 900)
        s = self.stats if isinstance(self.stats, dict) else {"stars": "–", "issues": "–", "releases": []}
        total = sum(d for _t, d, _w in s["releases"]) if s["releases"] else "–"
        grid = QWidget()
        gl = QGridLayout(grid)
        gl.setContentsMargins(0, 0, 0, 0)
        gl.setSpacing(12)
        for i, (val, label, color) in enumerate([(online, "Online now", "#22c55e"), (len(com), "Users seen", "#8b5cf6"),
                                                 (total, "Downloads", "#6366f1"), (s["stars"], "Stars", "#f59e0b"),
                                                 (s["issues"], "Open issues", "#ef4444")]):
            gl.addWidget(big_number(val, label, color), 0, i)
        p.add(grid)
        if com:
            for title, field in (("Versions", "v"), ("Modes", "mode"), ("Languages", "lang")):
                bars(p.group(title), Counter(u.get(field, "") for u in com.values()))
        else:
            p.group("Users", "Users report their version, mode and language when they join the official group. "
                    "Create it on the Community page and keep Nebula Chat running.")
        g = p.group("Downloads by version")
        if isinstance(self.stats, Exception):
            g.widget(QLabel(_("GitHub is not reachable: {}").format(self.stats)))
        elif self.stats is None:
            g.widget(QLabel(_("Loading statistics from GitHub…")))
        elif not s["releases"]:
            g.widget(QLabel(_("No releases yet. Publish one on the Release page.")))
        else:
            bars(g, Counter({f"{t} · {w}": d for t, d, w in s["releases"]}))
        g2 = p.group()
        g2.action("Issues and questions from users", "", "Open",
                  lambda: subprocess.Popen(["xdg-open", f"https://github.com/{REPO}/issues"]))
        g2.action("Refresh statistics", "", "Refresh", lambda: background(fetch_stats, self.got_stats))
        return p

    # ---------- News ----------
    def page_news(self):
        p = Page("News", "Every NebulaOS shows new items as a notification (checked every 6 hours).")
        data = self.channel()
        g = p.group("New announcement")
        title = QLineEdit()
        title.setPlaceholderText(_("Title"))
        text = QPlainTextEdit()
        text.setPlaceholderText(_("Text"))
        text.setFixedHeight(90)
        level = QComboBox()
        level.addItems([_("Normal"), _("Important (stays on screen)")])
        action = QComboBox()
        actions = [("", "No button"), ("update", "Button: Update now"), ("chat", "Button: Open Nebula Chat"),
                   ("settings", "Button: Open Settings"), ("url", "Button: Open a link…")]
        action.addItems([_(label) for _k, label in actions])
        for w in (title, text, level, action):
            g.widget(w)

        def go():
            if not title.text().strip():
                return
            act = actions[action.currentIndex()][0]
            if act == "url":
                url, ok = QInputDialog.getText(self, _("Link"), "https://…")
                if not ok or not url.startswith("https://"):
                    return
                act = url
            data.setdefault("news", []).append({"id": time.strftime("%Y%m%d-%H%M%S"), "title": title.text().strip(),
                                                "text": text.toPlainText().strip(), "action": act,
                                                "level": "important" if level.currentIndex() else "info"})
            data["news"] = data["news"][-20:]
            if self.publish(data, "News: " + title.text().strip()):
                self.reload()
        btn = QPushButton(_("Publish to all users"))
        btn.setDefault(True)
        btn.clicked.connect(go)
        g.widget(btn)
        g2 = p.group("Published")
        for i, n in reversed(list(enumerate(data.get("news", [])))):
            def remove(i=i):
                data["news"].pop(i)
                self.publish(data, "News: remove an item") and self.reload()
            g2.action(("⚠ " if n.get("level") == "important" else "") + n.get("title", ""), n.get("text", ""),
                      "Remove", remove)
        return p

    # ---------- Polls ----------
    def page_polls(self):
        p = Page("Polls", "Users vote in Nebula Chat → Feed. Votes arrive through the official group.")
        data = self.channel()
        results = community().get("poll_results", {})
        g = p.group("New poll")
        q = QLineEdit()
        q.setPlaceholderText(_("Question"))
        opts = QLineEdit()
        opts.setPlaceholderText(_("Answers, separated by commas"))
        g.widget(q)
        g.widget(opts)

        def go():
            options = [o.strip() for o in opts.text().split(",") if o.strip()][:6]
            if not q.text().strip() or len(options) < 2:
                QMessageBox.information(self, _("Polls"), _("A question and at least two answers."))
                return
            data.setdefault("polls", []).append({"id": time.strftime("%Y%m%d%H%M%S"), "question": q.text().strip(),
                                                 "options": options})
            self.publish(data, "Poll: " + q.text().strip()) and self.reload()
        b = QPushButton(_("Ask everyone"))
        b.setDefault(True)
        b.clicked.connect(go)
        g.widget(b)
        for i, poll in reversed(list(enumerate(data.get("polls", [])))):
            votes = Counter(results.get(str(poll.get("id")), {}).values())
            pg = p.group("📊 " + poll.get("question", ""), _("Votes: {}").format(sum(votes.values())))
            bars(pg, Counter({o: votes.get(o, 0) for o in poll.get("options", [])}) + Counter())
            for o in poll.get("options", []):
                if o not in votes:
                    pg.widget(QLabel(f"{o}: 0"))

            def close(i=i):
                data["polls"].pop(i)
                self.publish(data, "Poll closed") and self.reload()
            pg.action("Close the poll", "", "Close", close)
        return p

    # ---------- Community ----------
    def page_community(self):
        p = Page("Community", "Official groups everyone joins automatically, and the ban list.")
        data = self.channel()
        g = p.group("Official groups")
        for i, grp in enumerate(data.get("groups", [])):
            def remove(i=i):
                data["groups"].pop(i)
                self.publish(data, "Community: remove a group") and self.reload()
            g.action("★ " + grp.get("name", ""), grp.get("chat_id", "")[:24] + "…", "Remove", remove)

        def create():
            name, ok = QInputDialog.getText(self, _("Official group"), _("Group name:"), text="NebulaOS Community")
            if not ok or not name.strip():
                return
            r = subprocess.run(["nebula-chat", "--create-group", name.strip()], capture_output=True, text=True, timeout=30)
            cid = r.stdout.strip().upper()
            if len(cid) != 64:
                QMessageBox.warning(self, _("NebulaOS Admin"), _("Open Nebula Chat first, then try again."))
                return
            data.setdefault("groups", []).append({"name": name.strip(), "chat_id": cid})
            self.publish(data, "Community: new official group " + name.strip()) and self.reload()
        g.action("Create an official group", "You become its owner: moderators, mute, kick, pinned message",
                 "Create", create, primary=not data.get("groups"))

        def pin():
            if not data.get("groups"):
                return
            text, ok = QInputDialog.getText(self, _("Pinned message"), _("Text:"), text=data["groups"][0].get("pinned", ""))
            if ok:
                for grp in data["groups"]:
                    grp["pinned"] = text.strip()
                self.publish(data, "Community: pinned message") and self.reload()
        g.action("Pinned message", (data.get("groups") or [{}])[0].get("pinned", ""), "Edit…", pin)

        b = p.group("Ban list", "Banned users are ignored by every NebulaOS and kicked from official groups.")
        com = community().get("community", {})
        for i, pk in enumerate(data.get("banned", [])):
            def unban(i=i):
                data["banned"].pop(i)
                self.publish(data, "Community: unban") and self.reload()
            b.action(com.get(pk, {}).get("name", pk[:16] + "…"), pk[:32] + "…", "Unban", unban)

        def ban():
            names = {f"{u.get('name', '?')} ({pk[:8]})": pk for pk, u in com.items() if pk not in data.get("banned", [])}
            choice, ok = QInputDialog.getItem(self, _("Ban"), _("User (or paste a public key):"),
                                              sorted(names) or [""], 0, True)
            if not ok:
                return
            pk = names.get(choice, choice.strip().upper()[:64])
            if len(pk) != 64:
                return
            data.setdefault("banned", []).append(pk)
            self.publish(data, "Community: ban") and self.reload()
        b.action("Ban a user", "", "Ban…", ban)
        return p

    # ---------- Support ----------
    def page_support(self):
        p = Page("Support", "Users press “Message NebulaOS Support” in Nebula Chat and land in your chats.")
        data = self.channel()
        sid = data.get("support_id", "")
        g = p.group("Support address")
        cur = QLabel(sid or _("Not set — users cannot write to support yet."))
        cur.setWordWrap(True)
        cur.setTextInteractionFlags(Qt.TextSelectableByMouse)
        cur.setStyleSheet("font-family: monospace;" if sid else "color: #f59e0b;")
        g.widget(cur)

        def use_mine():
            me = subprocess.run(["nebula-chat", "--print-id"], capture_output=True, text=True, timeout=30).stdout.strip()
            if len(me) != 76:
                QMessageBox.warning(self, _("NebulaOS Admin"), _("Could not read your Nebula ID."))
                return
            data["support_id"] = me
            self.publish(data, "Support: new support address") and self.reload()
        g.action("Use my Nebula ID as support", "Support requests come to this computer's Nebula Chat",
                 "Use mine", use_mine, primary=not sid)
        p.group().action("Open support chats", "Requests marked 🛟 are from support", "Open",
                         lambda: subprocess.Popen(["nebula-chat"]))
        return p

    # ---------- Wallpaper ----------
    def page_wallpaper(self):
        p = Page("Wallpaper", "A wallpaper of the week: every NebulaOS gets it with a “Set” button.")
        data = self.channel()
        wp = data.get("wallpaper") or {}
        g = p.group("Current")
        g.widget(QLabel(wp.get("title") or _("None")))

        def choose():
            path, _f = QFileDialog.getOpenFileName(self, _("Wallpaper"), str(Path.home()), "Images (*.png *.jpg *.jpeg)")
            if not path:
                return
            title, ok = QInputDialog.getText(self, _("Wallpaper"), _("Title:"), text=Path(path).stem)
            if not ok:
                return
            raw = Path(path).read_bytes()
            if len(raw) > 25_000_000:
                QMessageBox.information(self, _("Wallpaper"), _("Up to 25 MB."))
                return
            sha = hashlib.sha256(raw).hexdigest()
            rel = f"channel/wallpapers/{sha[:12]}{Path(path).suffix.lower()}"
            (self.checkout / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(path, self.checkout / rel)
            data["wallpaper"] = {"title": title.strip(), "url": f"{RAW}/{rel}", "sha256": sha}
            self.publish(data, "Wallpaper of the week: " + title.strip(), extra=[rel]) and self.reload()
        g.action("Publish a new wallpaper", "PNG or JPG, 4K is fine", "Choose…", choose, primary=True)
        return p

    # ---------- Release ----------
    def page_release(self):
        p = Page("Release", "Publishing builds the package, uploads it to GitHub and notifies every NebulaOS.")
        data = self.channel()
        latest = data.get("latest", "0.0.0")
        try:
            a, b, c = (int(x) for x in latest.split("."))
            suggest = f"{a}.{b}.{c + 1}"
        except ValueError:
            suggest = "0.6.1"
        g = p.group("Publish an update", f"{_('Latest published')}: {latest}")
        ver = QLineEdit(suggest)
        note = QLineEdit()
        note.setPlaceholderText(_("What is new, in one line"))
        g.widget(ver)
        g.widget(note)

        def release():
            if not self.ready():
                return
            if QMessageBox.question(self, _("NebulaOS Admin"),
                                    _("Publish NebulaOS {} to all users?").format(ver.text().strip())) != QMessageBox.Yes:
                return
            in_terminal("bash", "-c", f"cd {shlex.quote(str(self.checkout))} && "
                        "{ command -v gh >/dev/null || sudo pacman -S --needed github-cli; } && "
                        "{ gh auth status >/dev/null 2>&1 || gh auth login; } && "
                        f"NEBULA_ADMIN_KEY={shlex.quote(str(KEY))} bash tools/release.sh "
                        f"{shlex.quote(ver.text().strip())} {shlex.quote(note.text().strip())}")
        btn = QPushButton(_("Publish update"))
        btn.setDefault(True)
        btn.clicked.connect(release)
        g.widget(btn)
        h = p.group("Hold back a broken release", "Users skip these NebulaOS versions until you release a fix.")
        for i, v in enumerate(data.get("blocked_versions", [])):
            def unhold(i=i):
                data["blocked_versions"].pop(i)
                self.publish(data, "Release: unhold") and self.reload()
            h.action(f"NebulaOS {v}", "", "Allow", unhold)

        def hold():
            v, ok = QInputDialog.getText(self, _("Hold back"), _("Version:"), text=latest)
            if ok and v.strip():
                data.setdefault("blocked_versions", []).append(v.strip())
                self.publish(data, f"Release: hold {v.strip()}") and self.reload()
        h.action("Hold back a version", "", "Hold…", hold)
        g2 = p.group("ISO image")
        g2.action("Build the ISO", "About 30–60 minutes, needs archiso", "Build",
                  lambda: self.ready() and in_terminal("bash", "-c", f"cd {shlex.quote(str(self.checkout))} && "
                                                       "sudo pacman -S --needed archiso grub && sudo bash build.sh"))
        g2.action("Open the output folder", "", "Open",
                  lambda: subprocess.Popen(["xdg-open", str(self.checkout / "out")]))
        return p

    # ---------- Keys ----------
    def page_keys(self):
        p = Page("Keys", "Only the holder of the signing key can publish to NebulaOS users.")
        g = p.group("Signing key")
        state = _("Ready") if self.ready(quiet=True) else (_("Found") if KEY.exists() else _("Missing"))
        g.widget(QLabel(f"{KEY}  —  {state}"))

        def import_key():
            path, _f = QFileDialog.getOpenFileName(self, _("admin.key"), str(Path.home()))
            if path:
                CONF.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(path, KEY)
                os.chmod(KEY, 0o600)
                self.reload()
        g.action("Import your admin.key", "From your backup (USB stick, password manager)", "Import…", import_key,
                 primary=not KEY.exists())
        r = p.group("Repository copy")
        ok = (self.checkout / ".git").exists()
        r.action(str(self.checkout), _("Ready") if ok else _("Not downloaded yet"), "Change…", self.pick_dir)
        if not ok:
            r.action("Download the repository", f"git clone github.com/{REPO}", "Download", lambda: in_terminal(
                "git", "clone", f"https://github.com/{REPO}.git", str(self.checkout)), primary=True)
        else:
            r.action("Get the latest changes", "git pull", "Pull",
                     lambda: in_terminal("git", "-C", str(self.checkout), "pull"))
        r.action("Sign in to GitHub", "Needed once to publish", "Sign in",
                 lambda: in_terminal("bash", "-c", "command -v gh >/dev/null || sudo pacman -S --needed github-cli; "
                                     "gh auth login && gh auth setup-git"))
        return p

    def pick_dir(self):
        d = QFileDialog.getExistingDirectory(self, _("Repository folder"), str(self.checkout.parent))
        if d:
            self.conf["checkout"] = d
            CONF.mkdir(parents=True, exist_ok=True)
            (CONF / "admin.json").write_text(json.dumps(self.conf))
            self.reload()


def main():
    a = app("nebula-admin", "nebula-admin")
    w = Admin()
    w.show()
    return a.exec()


if __name__ == "__main__":

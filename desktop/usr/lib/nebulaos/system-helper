#!/usr/bin/env bash
# NebulaOS system helper, run as root through pkexec by NebulaOS apps (no terminal needed).
#   system-helper install <package>...           install packages from the repositories
#   system-helper blackarch-enable                add the BlackArch repository (2800+ security tools)
#   system-helper usb-write <device> <iso>        write a disk image to a USB stick
#   system-helper usb-format <device> <exfat|fat32|ext4|ntfs> <label>
#   system-helper tor|mac|anon on|off             Tor, random MAC address, or both
# Prints "STEP: <text>" and "PROGRESS: <0-100>" lines the apps show.
set -euo pipefail
step() { printf 'STEP: %s\n' "$*"; }

# Only whole removable USB disks, never the disk the system runs from.
check_usb() {
  local dev=$1 name tran rm type root_disk
  [[ $dev =~ ^/dev/(sd[a-z]+|mmcblk[0-9]+|nvme[0-9]+n[0-9]+)$ ]] || { echo "not a disk: $dev" >&2; exit 2; }
  name=${dev#/dev/}
  read -r tran rm type < <(lsblk -dno TRAN,RM,TYPE "$dev")
  [[ $type == disk && ( $tran == usb || $rm == 1 ) ]] || { echo "$dev is not a removable USB disk" >&2; exit 2; }
  root_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null | head -1 || true)
  [[ $name != "$root_disk" ]] || { echo "$dev holds the running system" >&2; exit 2; }
}

unmount_all() {
  local part
  for part in $(lsblk -lnpo NAME "$1" | tail -n +2); do umount -f "$part" 2>/dev/null || true; done
  umount -f "$1" 2>/dev/null || true
}

cmd=${1:-}; shift || true
case $cmd in
  install)
    (( $# )) || exit 2
    for p in "$@"; do [[ $p =~ ^[a-z0-9@._+-]+$ ]] || { echo "bad package name: $p" >&2; exit 2; }; done
    step "Installing"
    pacman -S --needed --noconfirm "$@" 2>&1
    step "Done" ;;
  blackarch-enable)
    if grep -q '^\[blackarch\]' /etc/pacman.conf; then step "Done"; exit 0; fi
    step "Downloading the BlackArch setup"
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    curl -fsSL https://blackarch.org/strap.sh -o "$tmp/strap.sh"
    step "Adding the BlackArch repository and its keys"
    bash "$tmp/strap.sh" 2>&1
    step "Done" ;;
  usb-write)
    dev=${1:-}; iso=${2:-}
    check_usb "$dev"
    [[ -f $iso ]] || { echo "file not found: $iso" >&2; exit 2; }
    step "Preparing the USB stick"
    unmount_all "$dev"
    total=$(stat -c %s "$iso")
    step "Writing"
    dd if="$iso" of="$dev" bs=4M oflag=direct conv=fsync status=progress 2>&1 | tr '\r' '\n' | while read -r line; do
      bytes=${line%% *}
      [[ $bytes =~ ^[0-9]+$ ]] && printf 'PROGRESS: %d\n' $(( bytes * 100 / total ))
    done
    step "Finishing (do not remove the stick)"
    sync
    step "Done" ;;
  usb-format)
    dev=${1:-}; fs=${2:-exfat}; label=${3:-USB}
    check_usb "$dev"
    label=$(printf '%s' "$label" | tr -cd 'A-Za-z0-9 _-' | cut -c1-11)
    step "Preparing the USB stick"
    unmount_all "$dev"
    wipefs -a "$dev" >/dev/null
    case $fs in
      exfat) parted -s "$dev" mklabel gpt mkpart data 1MiB 100% ;;
      fat32) parted -s "$dev" mklabel msdos mkpart primary fat32 1MiB 100% ;;
      ntfs)  parted -s "$dev" mklabel gpt mkpart data 1MiB 100% ;;
      ext4)  parted -s "$dev" mklabel gpt mkpart data 1MiB 100% ;;
      *) echo "unknown file system: $fs" >&2; exit 2 ;;
    esac
    udevadm settle
    part=$(lsblk -lnpo NAME "$dev" | sed -n 2p)
    step "Formatting"
    case $fs in
      exfat) mkfs.exfat -n "$label" "$part" ;;
      fat32) mkfs.fat -F 32 -n "${label^^}" "$part" ;;
      ntfs)  mkfs.ntfs -f -L "$label" "$part" ;;
      ext4)  mkfs.ext4 -F -L "$label" "$part" ;;
    esac
    sync
    step "Done" ;;
  tor|mac|anon)
    what=$cmd; state=${1:-}
    [[ $state == on || $state == off ]] || exit 2
    if [[ $what == mac || $what == anon ]]; then
      conf=/etc/NetworkManager/conf.d/90-nebula-mac.conf
      if [[ $state == on ]]; then
        step "New random MAC address"
        printf '[device]
wifi.scan-rand-mac-address=yes

[connection]
wifi.cloned-mac-address=random
ethernet.cloned-mac-address=random
' > "$conf"
      else
        step "Real MAC address back"
        rm -f "$conf"
      fi
      systemctl restart NetworkManager
    fi
    if [[ $what == tor || $what == anon ]]; then
      if [[ $state == on ]]; then
        pacman -Q tor torsocks >/dev/null 2>&1 || { step "Installing Tor"; pacman -S --needed --noconfirm tor torsocks 2>&1; }
        step "Starting Tor"
        systemctl start tor
        for _ in $(seq 30); do ss -Htln | grep -q ':9050 ' && break; sleep 1; done
      else
        step "Stopping Tor"
        systemctl stop tor 2>/dev/null || true
      fi
    fi
    step "Done" ;;
  *) echo "usage: system-helper install|blackarch-enable|usb-write|usb-format|anon ..." >&2; exit 2 ;;
esac

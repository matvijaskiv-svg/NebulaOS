    ("John the Ripper", "Check password strength", "john", ["term", "john"]),
    ("hashcat", "Password recovery on GPU", "hashcat", ["term", "hashcat", "--help"]),
]


def local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("10.255.255.255", 1))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return ""


def local_net():
    out = subprocess.run(["ip", "-o", "-4", "addr", "show", "scope", "global"], capture_output=True, text=True).stdout
    m = re.search(r"inet (\d+\.\d+\.\d+\.\d+/\d+)", out)
    if not m:
        return None
    net = ipaddress.ip_network(m.group(1), strict=False)
    return str(net if 22 <= net.prefixlen <= 30 else ipaddress.ip_network(f"{local_ip()}/24", strict=False))


def scan_network():
    """[(ip, mac, name)] — nmap ping scan when installed, else the neighbour table."""
    net = local_net()
    rows = []
    if net and shutil.which("nmap"):
        out = subprocess.run(["nmap", "-sn", "-T4", net], capture_output=True, text=True, timeout=120).stdout
        host = None
        for line in out.splitlines():
            m = re.match(r"Nmap scan report for (?:(\S+) \()?(\d+\.\d+\.\d+\.\d+)\)?", line)
            if m:
                host = [m.group(2), "", m.group(1) or ""]
                rows.append(host)
            m = re.match(r"MAC Address: (\S+)(?: \((.*)\))?", line)
            if m and host:
                host[1] = m.group(1)
                host[2] = host[2] or (m.group(2) or "")
    else:
        out = subprocess.run(["ip", "neigh"], capture_output=True, text=True).stdout
        for line in out.splitlines():
            f = line.split()
            if f and "lladdr" in f:
                rows.append([f[0], f[f.index("lladdr") + 1], ""])
    return [tuple(r) for r in rows]


def scan_ports(host):
    if shutil.which("nmap"):
        out = subprocess.run(["nmap", "-T4", "--top-ports", "200", "-sV", "--version-light", host],
                             capture_output=True, text=True, timeout=300).stdout
        return [tuple((line.split(None, 3) + ["", "", ""])[:4]) for line in out.splitlines()
                if re.match(r"^\d+/(tcp|udp)\s", line)]
    rows = []
    for port in (21, 22, 23, 25, 53, 80, 110, 139, 143, 443, 445, 3306, 3389, 5432, 5900, 8080, 9090):
        try:
            with socket.create_connection((host, port), timeout=0.4):
                rows.append((f"{port}/tcp", "open", "", ""))
        except OSError:
            pass
    return rows


def wifi_networks():
    out = subprocess.run(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY,CHAN", "dev", "wifi", "list"],
                         capture_output=True, text=True, timeout=30).stdout
    rows = []
    for line in out.splitlines():
        parts = re.split(r"(?<!\\):", line)
        if len(parts) >= 4 and parts[0]:
            rows.append((parts[0].replace("\\:", ":"), parts[1] + "%", parts[2] or _("open"), parts[3]))
    return sorted(rows, key=lambda r: -int(r[1].rstrip("%") or 0))


def table(headers):
    t = QTableWidget(0, len(headers))
    t.setHorizontalHeaderLabels([_(h) for h in headers])
    t.verticalHeader().hide()
    t.setEditTriggers(QTableWidget.NoEditTriggers)
    t.setSelectionBehavior(QTableWidget.SelectRows)
    t.setShowGrid(False)
    t.setAlternatingRowColors(True)
    t.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
    t.setMinimumHeight(320)
    return t


def fill(t, rows):
    t.setRowCount(len(rows))
    for r, row in enumerate(rows):
        for c, val in enumerate(row):
            t.setItem(r, c, QTableWidgetItem(str(val)))



def installed_pkgs():
    try:
        return set(subprocess.run(["pacman", "-Qq"], capture_output=True, text=True, timeout=20).stdout.split())
    except (OSError, subprocess.TimeoutExpired):
        return set()


def blackarch_on():
    try:
        return "[blackarch]" in Path("/etc/pacman.conf").read_text()
    except OSError:
        return False


def group_size(group):
    try:
        return len(subprocess.run(["pacman", "-Sgq", group], capture_output=True, text=True, timeout=20).stdout.split())
    except (OSError, subprocess.TimeoutExpired):
        return 0


class Toolkit(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(_("Toolkit"))
        self.nav = QListWidget()
        self.nav.setObjectName("nav")
        self.nav.setFixedWidth(220)
        self.nav.setIconSize(QSize(24, 24))
        self.stack = QStackedWidget()
        for title, icon, color, page in (("Network devices", "network-workgroup", "#0a84ff", self.page_devices),
                                         ("Port check", "network-server", "#ff9f0a", self.page_ports),
                                         ("Wi-Fi around", "network-wireless", "#30d158", self.page_wifi),
                                         ("Tool sets", "applications-system", "#5b6b7f", self.page_sets),
                                         ("Privacy", "security-high", "#5b6b7f", self.page_privacy),
                                         ("Labs", "applications-science", "#bf5af2", self.page_labs),
                                         ("Lessons", "accessories-dictionary", "#ff375f", self.page_lessons),
                                         ("Password check", "dialog-password", "#ffd60a", self.page_password),
                                         ("Tools", "utilities-terminal", "#64d2ff", self.page_tools)):
            item = QListWidgetItem(tile(icon, color), _(title))
            item.setSizeHint(QSize(0, 38))
            self.nav.addItem(item)
            self.stack.addWidget(page())
        self.nav.currentRowChanged.connect(self.stack.setCurrentIndex)
        body = QWidget()
        lay = QHBoxLayout(body)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)
        lay.addWidget(self.nav)
        lay.addWidget(self.stack, 1)
        self.setCentralWidget(body)
        self.nav.setCurrentRow(0)
        fit(self, 1080, 700)

    def page_devices(self):
        p = Page("Network devices", "Who is on your local network right now.")
        g = p.group()
        ip = local_ip()
        g.action(_("This computer: {}").format(ip or "—"), local_net() or "", "Copy",
                 lambda: QGuiApplication.clipboard().setText(ip))
        status = QLabel(_("Press Scan."))
        status.setStyleSheet("color: palette(placeholder-text);")
        t = table(["Address", "MAC", "Name / vendor"])

        def scan():
            status.setText(_("Scanning… up to a minute."))
            btn.setEnabled(False)

            def done(rows):
                btn.setEnabled(True)
                rows = rows if isinstance(rows, list) else []
                status.setText(_("Devices found: {}").format(len(rows)))
                fill(t, rows)
            background(scan_network, done)
        btn = g.action("Scan the network", "nmap -sn" if shutil.which("nmap") else _("Install Nmap for a full scan"),
                       "Scan", scan, primary=True)
        p.add(status)
        p.add(t)
        return p

    def page_ports(self):
        p = Page("Port check", "Which services a computer you own has open.")
        g = p.group()
        host = QLineEdit(local_ip() or "127.0.0.1")
        host.setPlaceholderText(_("Address or name"))
        g.widget(host)
        status = QLabel("")
        status.setStyleSheet("color: palette(placeholder-text);")
        t = table(["Port", "State", "Service", "Version"])

        def scan():
            target = host.text().strip()
            if not re.match(r"^[A-Za-z0-9.\-:]+$", target):
                status.setText(_("This is not an address."))
                return
            status.setText(_("Checking {}…").format(target))

            def done(rows):
                rows = rows if isinstance(rows, list) else []
                status.setText(_("Open ports: {}").format(len(rows)))
                fill(t, rows)
            background(lambda: scan_ports(target), done)
        g.action("Check ports", "nmap --top-ports 200" if shutil.which("nmap") else _("Basic check without Nmap"),
                 "Check", scan, primary=True)
        p.add(status)
        p.add(t)
        return p

    def page_wifi(self):
        p = Page("Wi-Fi around", "Networks your Wi-Fi card can see.")
        t = table(["Network", "Signal", "Security", "Channel"])
        status = QLabel(_("Searching…"))
        status.setStyleSheet("color: palette(placeholder-text);")

        def refresh():
            def done(rows):
                rows = rows if isinstance(rows, list) else []
                status.setText(_("Networks: {}").format(len(rows)))
                fill(t, rows)
            background(wifi_networks, done)
        g = p.group()
        g.action("Refresh", "", "Refresh", refresh)
        p.add(status)
        p.add(t)
        refresh()
        return p

    def page_privacy(self):
        p = Page("Privacy")
        tor = subprocess.run(["systemctl", "is-active", "--quiet", "tor"]).returncode == 0
        mac = Path("/etc/NetworkManager/conf.d/90-nebula-mac.conf").exists()
        g = p.group()
        g.switch("Anonymous mode", "Random MAC address and Tor together, in one click", tor and mac,
                 lambda on: self.priv("anon", on))
        g.switch("Tor", "Anonymous connection on 127.0.0.1:9050; run an app through it with torsocks", tor,
                 lambda on: self.priv("tor", on))
        g.switch("Random MAC address", "A new hardware address for Wi-Fi and Ethernet", mac,
                 lambda on: self.priv("mac", on))
        if tor and shutil.which("torsocks"):
            g.action("Browser through Tor", "Firefox with a private profile, all traffic over Tor", "Open",
                     lambda: subprocess.Popen(["torsocks", "firefox", "--private-window", "--no-remote",
                                               "--profile", str(self.tor_profile()), "https://check.torproject.org"]))
        pub = p.group("Public address")
        lbl = QLabel("…")
        pub.widget(lbl)
        cmd = (["torsocks"] if tor and shutil.which("torsocks") else []) + \
            ["curl", "-s", "--max-time", "10", "https://ifconfig.me"]
        background(lambda: subprocess.run(cmd, capture_output=True, text=True).stdout.strip(),
                   lambda ip: lbl.setText((ip + ("   ·   Tor" if tor else "")) if isinstance(ip, str) and ip else "—"))
        return p

    def tor_profile(self):
        prof = Path.home() / ".local/share/nebulaos/tor-firefox"
        prof.mkdir(parents=True, exist_ok=True)
        (prof / "user.js").write_text('user_pref("network.proxy.type", 1);\n'
                                      'user_pref("network.proxy.socks", "127.0.0.1");\n'
                                      'user_pref("network.proxy.socks_port", 9050);\n'
                                      'user_pref("network.proxy.socks_remote_dns", true);\n'
                                      'user_pref("media.peerconnection.enabled", false);\n', encoding="utf-8")
        return prof

    def priv(self, what, on):
        helper(self, _("Privacy"), what, "on" if on else "off")
        self.refresh()

    def page_sets(self):
        p = Page("Tool sets")
        have = installed_pkgs()
        ba = blackarch_on()
        for title, desc, pkgs, group in TOOL_SETS:
            missing = [x for x in pkgs if x not in have]
            g = p.group(title)
            sub = f"{_(desc)}  ·  {', '.join(pkgs)}"
            if missing:
                g.action(_("{} of {} installed").format(len(pkgs) - len(missing), len(pkgs)), sub, "Install",
                         lambda m=missing, t=title: self.install(t, m), primary=True)
            else:
                g.row(_("All installed"), sub)
            if ba:
                n = group_size(group)
                if n:
                    g.action(_("Everything from BlackArch"), _("{} tools").format(n), "Install all",
                             lambda gr=group, t=title: self.install(t, [gr]))
        extra = p.group("BlackArch")
        if ba:
            extra.row(_("BlackArch is on"), _("More than 2800 tools, same as Kali and more"))
        else:
            extra.action(_("Add BlackArch"), _("More than 2800 security tools, same as Kali and more"), "Add",
                         self.enable_blackarch, primary=True)
        return p

    def install(self, title, pkgs):
        helper(self, _(title), "install", *pkgs)
        self.refresh()

    def enable_blackarch(self):
        if helper(self, "BlackArch", "blackarch-enable"):
            self.refresh()

    def refresh(self):
        row = self.nav.currentRow()
        self.nav.setCurrentRow(-1)
        self.nav.setCurrentRow(row)

    def page_labs(self):
        p = Page("Labs", "Practice targets that run in Docker and are reachable only from this computer.")
        g = p.group()
        labs = re.findall(r"^\s+(\S+)\s+(http://127\.0\.0\.1:\d+)", run("lab", "list")[1], re.M)
        for name, url in labs:
            g.action(name, url, "Start", lambda n=name: in_terminal("nebula", "lab", "start", n))
        if not labs:
            g.action("Labs need Docker", "", "Install", lambda: in_terminal("nebula", "server", "enable", "docker"))
        return p

    def page_lessons(self):
        p = Page("Lessons", "Step by step, on practice labs that run only on this computer.")
        for title, lab, path, steps in LESSONS:
            g = p.group(title)
            text = QLabel(chr(10).join(_(step) for step in steps))
            text.setWordWrap(True)
            g.widget(text)
            if lab:
                g.action("Start the lab", lab, "Start", lambda l=lab: in_terminal("nebula", "lab", "start", l))
            g.action("Ask for a hint", "", "Hint", lambda t=title: subprocess.Popen(
                ["nebula-ai-overlay", "--ask", f"I am doing the NebulaOS lesson '{t}' on my own practice lab. "
                                               "Give me a small hint for the next step, not the full answer."]))
        return p

    def page_password(self):
        p = Page("Password check", "Is a password in known leaks? Only the first 5 characters of its "
                                   "SHA-1 hash are sent; the password itself never leaves this computer.")
        g = p.group()
        field = QLineEdit()
        field.setEchoMode(QLineEdit.Password)
        field.setPlaceholderText(_("Password"))
        g.widget(field)
        result = QLabel("")
        result.setWordWrap(True)

        def check():
            pw = field.text()
            if not pw:
                return
            result.setText(_("Checking…"))

            def done(n):
                if isinstance(n, Exception):
                    result.setText(_("No internet connection."))
                elif n:
                    result.setText("⚠ " + _("Found in leaks {} times. Do not use this password.").format(n))
                    result.setStyleSheet("color: #ff453a; font-weight: bold;")
                else:
                    result.setText("✓ " + _("Not found in known leaks."))
                    result.setStyleSheet("color: #30d158; font-weight: bold;")
            background(lambda: password_leaks(pw), done)
        field.returnPressed.connect(check)
        g.action("Check the password", "", "Check", check, primary=True)
        g.widget(result)
        return p

    def page_tools(self):
        p = Page("Tools", "Use them only on your own devices and labs.")
        g = p.group()
        for name, desc, pkg, cmd in TOOLS:
            exe = cmd[1] if cmd[0] == "term" else cmd[0]
            if shutil.which(exe):
                action = (lambda c=cmd: in_terminal(*c[1:])) if cmd[0] == "term" else (lambda c=cmd: subprocess.Popen(c))
                g.action(name, desc, "Open", action)
            else:
                g.action(name, desc, "Install", lambda pk=pkg, n=name: self.install(n, [pk]))
        return p


def main():
    a = app("nebula-toolkit", "utilities-terminal")
    w = Toolkit()
    w.show()
    return a.exec()


if __name__ == "__main__":
    sys.exit(main())

def password_leaks(password):
    """How many times the password appears in known leaks (Have I Been Pwned, k-anonymity:
    only the first 5 characters of the SHA-1 hash leave this computer)."""
    import hashlib
    import urllib.request
    digest = hashlib.sha1(password.encode()).hexdigest().upper()
    req = urllib.request.Request(f"https://api.pwnedpasswords.com/range/{digest[:5]}",
                                 headers={"User-Agent": "NebulaOS-Toolkit", "Add-Padding": "true"})
    with urllib.request.urlopen(req, timeout=15) as r:
        for line in r.read().decode().splitlines():
            suffix, _sep, count = line.partition(":")
            if suffix == digest[5:]:
                return int(count)
    return 0



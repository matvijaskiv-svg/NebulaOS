#!/usr/bin/env python3
"""Move from Windows: finds the Windows partition next to NebulaOS and copies your
Documents, Pictures, Music, Videos, Desktop and Downloads (into "From Windows"
folders, nothing is overwritten), the wallpaper and the Chrome/Edge bookmarks."""
import html
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/nebulaos")
from nebula_qt import _, Page, app, background, fit, run  # noqa: E402
from PySide6.QtCore import QProcess  # noqa: E402
from PySide6.QtWidgets import QCheckBox, QLabel, QMainWindow, QMessageBox, QProgressBar, QPushButton  # noqa: E402

FOLDERS = [  # (Windows folder, NebulaOS folder name via xdg-user-dir, title)
    ("Documents", "DOCUMENTS", "Documents"), ("Pictures", "PICTURES", "Pictures"), ("Music", "MUSIC", "Music"),
    ("Videos", "VIDEOS", "Videos"), ("Desktop", "DESKTOP", "Desktop"), ("Downloads", "DOWNLOAD", "Downloads"),
]
SKIP_USERS = {"Public", "Default", "Default User", "All Users", "defaultuser0"}


def sh(*cmd, timeout=30):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def windows_roots():
    """Mount every NTFS partition (udisks asks for permission if needed); return those with Windows users."""
    found = []
    try:
        data = json.loads(sh("lsblk", "-J", "-p", "-o", "NAME,FSTYPE,MOUNTPOINT,LABEL"))
    except ValueError:
        return found

    def walk(devs):
        for d in devs:
            yield d
            yield from walk(d.get("children") or [])
    for d in walk(data.get("blockdevices", [])):
        if d.get("fstype") not in ("ntfs", "ntfs3"):
            continue
        mp = d.get("mountpoint")
        if not mp:
            out = sh("udisksctl", "mount", "-b", d["name"], "--options", "ro", timeout=60)
            m = re.search(r" at (\S+)", out)
            mp = m.group(1).rstrip(".") if m else None
        if mp and (Path(mp) / "Users").is_dir():
            found.append(Path(mp))
    return found


def win_users(root):
    return [u for u in (root / "Users").iterdir() if u.is_dir() and u.name not in SKIP_USERS and (u / "Documents").exists()]


def size_of(path):
    out = sh("du", "-sb", str(path), timeout=120)
    try:
        return int(out.split()[0])
    except (IndexError, ValueError):
        return 0


def gb(n):
    return f"{n / 2**30:.1f} GB" if n >= 2**30 else f"{n / 2**20:.0f} MB"


def xdg(name):
    p = sh("xdg-user-dir", name).strip()
    return Path(p) if p else Path.home() / name.capitalize()


def bookmarks_html(user):
    """Chrome/Edge bookmarks → one HTML file Firefox can import."""
    rows = []

    def walk(node, depth=1):
        if node.get("type") == "url":
            rows.append("    " * depth + f'<DT><A HREF="{html.escape(node.get("url", ""))}">{html.escape(node.get("name", ""))}</A>')
        for child in node.get("children", []):
            walk(child, depth + 1)
    for browser in ("Google/Chrome", "Microsoft/Edge"):
        f = user / "AppData/Local" / browser / "User Data/Default/Bookmarks"
        try:
            data = json.loads(f.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        for root in data.get("roots", {}).values():
            if isinstance(root, dict):
                walk(root)
    if not rows:
        return None
    return ("<!DOCTYPE NETSCAPE-Bookmark-file-1>\n<TITLE>Bookmarks from Windows</TITLE>\n<H1>Bookmarks</H1>\n<DL><p>\n"
            + "\n".join(rows) + "\n</DL><p>\n")


class Migrate(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(_("Move from Windows"))
        self.boxes, self.queue, self.proc = [], [], None
        p = Page("Move from Windows", "Searching for Windows…")
        self.setCentralWidget(p)
        background(lambda: [(r, win_users(r)) for r in windows_roots()], self.found)
        fit(self, 820, 680)

    def found(self, result):
        result = result if isinstance(result, list) else []
        users = [(root, u) for root, us in result for u in us]
        p = Page("Move from Windows", "Your files are copied into “From Windows” folders; nothing here is overwritten.")
        if not users:
            g = p.group()
            g.widget(QLabel(_("Windows was not found on this computer.")))
            self.setCentralWidget(p)
            return
        self.user = users[0][1]
        g = p.group(_("Windows user: {}").format(self.user.name))
        for win, xdg_name, title in FOLDERS:
            src = self.user / win
            if src.exists():
                box = QCheckBox(f"{_(title)}   ·   …")
                box.setChecked(win != "Downloads")
                g.widget(box)
                self.boxes.append((box, src, xdg_name, title))
                background(lambda s=src: size_of(s),
                           lambda n, b=box, t=title: b.setText(f"{_(t)}   ·   {gb(n) if isinstance(n, int) else '?'}"))
        self.wall = QCheckBox(_("Wallpaper"))
        self.wall.setChecked(True)
        self.marks = QCheckBox(_("Browser bookmarks (Chrome, Edge)"))
        self.marks.setChecked(True)
        g.widget(self.wall)
        g.widget(self.marks)
        self.bar = QProgressBar()
        self.bar.hide()
        self.status = QLabel("")
        g.widget(self.bar)
        g.widget(self.status)
        self.go = QPushButton(_("Move"))
        self.go.setDefault(True)
        self.go.clicked.connect(self.start)
        g.widget(self.go)
        self.setCentralWidget(p)

    def start(self):
        self.go.setEnabled(False)
        self.bar.show()
        self.queue = [(src, xdg(name) / _("From Windows"), title) for box, src, name, title in self.boxes if box.isChecked()]
        self.extras()
        self.next()

    def extras(self):
        pics = xdg("PICTURES") / _("From Windows")
        if self.wall.isChecked():
            w = self.user / "AppData/Roaming/Microsoft/Windows/Themes/TranscodedWallpaper"
            if w.exists():
                pics.mkdir(parents=True, exist_ok=True)
                target = pics / "windows-wallpaper.jpg"
                shutil.copyfile(w, target)
                run("settings", "wallpaper", str(target))
        if self.marks.isChecked():
            page = bookmarks_html(self.user)
            if page:
                docs = xdg("DOCUMENTS") / _("From Windows")
                docs.mkdir(parents=True, exist_ok=True)
                (docs / "bookmarks.html").write_text(page, encoding="utf-8")

    def next(self):
        if not self.queue:
            self.bar.setValue(100)
            self.status.setText(_("Done. Bookmarks: Firefox → Bookmarks → Manage → Import from HTML "
                                  "(Documents/From Windows/bookmarks.html)."))
            QMessageBox.information(self, _("Move from Windows"), _("Everything is moved."))
            return
        src, dst, title = self.queue.pop(0)
        dst.mkdir(parents=True, exist_ok=True)
        self.status.setText(_("Copying: {}").format(_(title)))
        self.bar.setRange(0, 100)
        self.bar.setValue(0)
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.progress)
        self.proc.finished.connect(lambda *_a: self.next())
        self.proc.start("rsync", ["-a", "--info=progress2", "--exclude", "desktop.ini", "--exclude", "*.lnk",
                                  f"{src}/", f"{dst}/{src.name}/"])

    def progress(self):
        text = bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        found = re.findall(r"(\d{1,3})%", text)
        if found:
            self.bar.setValue(int(found[-1]))


def main():
    a = app("nebula-migrate", "folder-windows")
    w = Migrate()
    w.show()
    return a.exec()


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Nebula Chat — messenger and feed for NebulaOS users, without a server.

Tox underneath: peer-to-peer, end-to-end encrypted. Private chats, groups with
roles (owner, moderators), photos and files, profiles with avatars, "typing…",
delivered / seen ticks, a feed of posts with likes, polls and official groups
from the signed NebulaOS channel.

    nebula-chat                      open the window
    nebula-chat --tray               start in the system tray (autostart)
    nebula-chat --print-id           print your Nebula ID
    nebula-chat --create-group NAME  (admin) create a group in the running app, print its code
"""
import base64
import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, "/usr/lib/nebulaos")
from nebula_qt import _, QIcon, app, background, fit, tile  # noqa: E402
from PySide6.QtCore import QBuffer, QByteArray, QIODevice, QSize, Qt, QTimer  # noqa: E402
from PySide6.QtGui import QAction, QColor, QGuiApplication, QImage, QPainter, QPainterPath, QPixmap  # noqa: E402
from PySide6.QtNetwork import QLocalServer, QLocalSocket  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QButtonGroup, QDialog, QDialogButtonBox, QFileDialog, QFrame, QHBoxLayout, QInputDialog, QLabel, QLineEdit,
    QListWidget, QListWidgetItem, QMainWindow, QMenu, QMessageBox, QPlainTextEdit, QPushButton, QScrollArea,
    QStackedWidget, QSystemTrayIcon, QToolButton, QVBoxLayout, QWidget,
)
import nebula_sign  # noqa: E402
import nebula_tox  # noqa: E402

DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "nebula-chat"
MEDIA = DATA / "media"
PROFILE = DATA / "profile.tox"
STATE = DATA / "chats.json"
NODES = DATA / "nodes.json"
STATS = DATA / "community.json"          # what the admin panel reads
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "nebulaos"
PREFIX = "NebulaOS|"
SUPPORT_NAME = "NebulaOS Support"
ONLINE, OFFLINE, ACCENT = "#22c55e", "#6b7280", "#8b5cf6"
NAME_COLORS = ["#f472b6", "#60a5fa", "#34d399", "#fbbf24", "#a78bfa", "#fb7185", "#2dd4bf", "#f97316"]
BUBBLE = {
    True: "background: palette(highlight); color: palette(highlighted-text); border-radius: 14px; padding: 8px 12px;",
    False: "background: palette(base); border: 1px solid palette(midlight); border-radius: 14px; padding: 8px 12px;",
}


# ---------- helpers ----------
def my_name():
    try:
        import pwd
        e = pwd.getpwuid(os.getuid())
        return e.pw_gecos.split(",")[0] or e.pw_name
    except (KeyError, ImportError):
        return os.environ.get("USER", "NebulaOS user")


def channel():
    """The NebulaOS channel, only if signed by the maintainer (else empty)."""
    for d in (CACHE, Path("/usr/share/nebulaos")):
        try:
            raw = (d / "channel.json").read_bytes()
            sig = (d / "channel.sig").read_text()
        except OSError:
            continue
        if nebula_sign.trusted(raw, sig):
            return json.loads(raw.decode())
    return {}


def is_valid_id(text, size=nebula_tox.ADDRESS_SIZE):
    t = text.strip().upper()
    return len(t) == size * 2 and all(c in "0123456789ABCDEF" for c in t)


def notify(title, body):
    try:
        subprocess.Popen(["notify-send", "-a", "Nebula Chat", "-i", "nebula-chat", title, body[:200]])
    except OSError:
        pass


def store_media(raw: bytes, ext):
    MEDIA.mkdir(parents=True, exist_ok=True)
    path = MEDIA / (hashlib.sha256(raw).hexdigest()[:24] + ext)
    if not path.exists():
        path.write_bytes(raw)
    return str(path)


def jpeg(path_or_image, size, quality=82):
    img = QImage(path_or_image) if isinstance(path_or_image, str) else path_or_image
    if img.isNull():
        return b""
    if max(img.width(), img.height()) > size:
        img = img.scaled(size, size, Qt.KeepAspectRatio, Qt.SmoothTransformation)
    ba = QByteArray()
    buf = QBuffer(ba)
    buf.open(QIODevice.WriteOnly)
    img.save(buf, "JPEG", quality)
    return bytes(ba)


def square_avatar(path):
    img = QImage(path)
    if img.isNull():
        return b""
    side = min(img.width(), img.height())
    img = img.copy((img.width() - side) // 2, (img.height() - side) // 2, side, side)
    return jpeg(img, 160, 85)


def avatar_pixmap(path, name, size=34):
    """Round avatar: the photo, or the first letter on a colour."""
    pm = QPixmap(size * 2, size * 2)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    clip = QPainterPath()
    clip.addEllipse(0, 0, size * 2, size * 2)
    p.setClipPath(clip)
    src = QPixmap(path) if path and Path(path).exists() else QPixmap()
    if not src.isNull():
        p.drawPixmap(0, 0, src.scaled(size * 2, size * 2, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation))
    else:
        p.fillRect(0, 0, size * 2, size * 2, QColor(NAME_COLORS[sum(map(ord, name or "?")) % len(NAME_COLORS)]))
        p.setPen(QColor("white"))
        font = p.font()
        font.setPixelSize(int(size * 0.95))
        font.setBold(True)
        p.setFont(font)
        p.drawText(pm.rect(), Qt.AlignCenter, (name or "?")[:1].upper())
    p.end()
    pm.setDevicePixelRatio(2)
    return pm


def when(ts):
    t = time.localtime(ts)
    return time.strftime("%H:%M", t) if time.strftime("%Y%m%d", t) == time.strftime("%Y%m%d") \
        else time.strftime("%d.%m %H:%M", t)


class Chat(QMainWindow):
    def __init__(self, tox):
        super().__init__()
        self.tox = tox
        self.setWindowTitle("Nebula Chat")
        self.state = self.load()
        self.online, self.typing_now, self.peers = {}, {}, {}
        self.current = None              # "u:<pk>" or "g:<chat_id>"
        self.channel = channel()
        self.banned = set(self.channel.get("banned", []))
        for ev in ("request", "message", "online", "friend_status", "typing", "receipt", "name", "data",
                   "group_message", "group_data", "group_invite", "group_peer", "group_ready"):
            setattr(tox, "on_" + ev, getattr(self, "ev_" + ev))
        tox.set_status(self.state["me"].get("status", ""))
        self.build_ui()
        self.refresh()
        for row in range(self.list.count()):
            if self.list.item(row).data(Qt.UserRole)[0] in ("u", "g"):
                self.list.setCurrentRow(row)
                break
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.tick)
        self.timer.start(50)
        self.saver = QTimer(self)
        self.saver.timeout.connect(self.housekeeping)
        self.saver.start(30000)
        self.typing_off = QTimer(self)
        self.typing_off.setSingleShot(True)
        self.typing_off.timeout.connect(lambda: self.current and self.current[0] == "u"
                                        and self.tox.typing(self.current[2:], False))
        background(lambda: nebula_tox.load_nodes(NODES), self.got_nodes)
        QTimer.singleShot(4000, self.join_official)
        fit(self, 1040, 700)

    # =============== state ===============
    def load(self):
        try:
            s = json.loads(STATE.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            s = {}
        for k in ("contacts", "groups", "requests", "invites", "posts", "votes"):
            s.setdefault(k, {})
        s.setdefault("me", {})
        return s

    def save(self):
        DATA.mkdir(parents=True, exist_ok=True)
        tmp = STATE.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.state, ensure_ascii=False), encoding="utf-8")
        os.chmod(tmp, 0o600)
        tmp.replace(STATE)

    def contact(self, pk, name=None):
        c = self.state["contacts"].setdefault(pk, {"name": name or pk[:8], "messages": []})
        if name and c["name"] == pk[:8]:
            c["name"] = name
        return c

    def group(self, cid):
        return self.state["groups"].setdefault(cid, {"name": self.tox.group_name(cid) or cid[:8], "messages": []})

    def chat(self, key):
        return self.contact(key[2:]) if key[0] == "u" else self.group(key[2:])

    # =============== UI ===============
    def build_ui(self):
        side = QWidget()
        side.setFixedWidth(300)
        sv = QVBoxLayout(side)
        sv.setContentsMargins(12, 12, 12, 12)
        sv.setSpacing(8)
        head = QHBoxLayout()
        self.me_btn = QToolButton()
        self.me_btn.setIconSize(QSize(34, 34))
        self.me_btn.setAutoRaise(True)
        self.me_btn.setToolTip(_("My profile"))
        self.me_btn.clicked.connect(self.edit_profile)
        head.addWidget(self.me_btn)
        title_box = QVBoxLayout()
        title_box.setSpacing(0)
        title = QLabel("Nebula Chat")
        f = title.font()
        f.setPointSizeF(f.pointSizeF() * 1.25)
        f.setBold(True)
        title.setFont(f)
        self.status_text = QLabel(_("Connecting…"))
        self.status_text.setStyleSheet("color: palette(placeholder-text); font-size: 9pt;")
        title_box.addWidget(title)
        title_box.addWidget(self.status_text)
        head.addLayout(title_box, 1)
        new = QToolButton()
        new.setIcon(QIcon.fromTheme("list-add"))
        new.setToolTip(_("New"))
        new.setPopupMode(QToolButton.InstantPopup)
        menu = QMenu(new)
        menu.addAction(QIcon.fromTheme("list-add-user"), _("Add contact"), self.add_contact)
        menu.addAction(QIcon.fromTheme("system-users"), _("New group"), self.new_group)
        menu.addAction(QIcon.fromTheme("go-jump"), _("Join a group by code"), self.join_group)
        menu.addSeparator()
        menu.addAction(QIcon.fromTheme("edit-copy"), _("Copy my Nebula ID"), self.copy_my_id)
        new.setMenu(menu)
        head.addWidget(new)
        sv.addLayout(head)

        tabs = QHBoxLayout()
        self.tab_group = QButtonGroup(self)
        for i, label in enumerate((_("Chats"), _("Feed"))):
            b = QPushButton(label)
            b.setCheckable(True)
            b.setChecked(i == 0)
            self.tab_group.addButton(b, i)
            tabs.addWidget(b)
        self.tab_group.idClicked.connect(self.switch_tab)
        sv.addLayout(tabs)
        self.search = QLineEdit()
        self.search.setPlaceholderText(_("Search"))
        self.search.setClearButtonEnabled(True)
        self.search.textChanged.connect(lambda _t: self.refresh())
        sv.addWidget(self.search)
        self.list = QListWidget()
        self.list.setObjectName("nav")
        self.list.setIconSize(QSize(34, 34))
        self.list.currentItemChanged.connect(self.open_item)
        self.list.setContextMenuPolicy(Qt.CustomContextMenu)
        self.list.customContextMenuRequested.connect(lambda pos: self.chat_menu(self.list.itemAt(pos), pos))
        sv.addWidget(self.list, 1)
        help_btn = QPushButton(tile("help-contents", "#16a34a", 18), _("Message NebulaOS Support"))
        help_btn.clicked.connect(self.open_support)
        sv.addWidget(help_btn)

        self.stack = QStackedWidget()
        empty = QLabel(_("Choose a chat or add a contact by their Nebula ID.") + "\n"
                       + _("Messages go directly between computers, encrypted — there is no server."))
        empty.setAlignment(Qt.AlignCenter)
        empty.setWordWrap(True)
        empty.setStyleSheet("color: palette(placeholder-text);")
        self.stack.addWidget(empty)
        self.stack.addWidget(self.build_conversation())
        self.stack.addWidget(self.build_feed())

        body = QWidget()
        lay = QHBoxLayout(body)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)
        lay.addWidget(side)
        line = QFrame()
        line.setFrameShape(QFrame.VLine)
        line.setStyleSheet("color: palette(midlight);")
        lay.addWidget(line)
        lay.addWidget(self.stack, 1)
        self.setCentralWidget(body)
        self.update_me()

        self.tray = QSystemTrayIcon(QIcon.fromTheme("nebula-chat"), self)
        tm = QMenu()
        tm.addAction(_("Open Nebula Chat"), self.bring_up)
        tm.addAction(_("Quit"), self.quit)
        self.tray.setContextMenu(tm)
        self.tray.activated.connect(lambda r: self.bring_up() if r == QSystemTrayIcon.Trigger else None)
        self.tray.show()

    def build_conversation(self):
        conv = QWidget()
        cv = QVBoxLayout(conv)
        cv.setContentsMargins(18, 12, 18, 14)
        cv.setSpacing(10)
        top = QHBoxLayout()
        self.peer_avatar = QLabel()
        top.addWidget(self.peer_avatar)
        names = QVBoxLayout()
        names.setSpacing(0)
        self.peer_name = QLabel()
        f = self.peer_name.font()
        f.setPointSizeF(f.pointSizeF() * 1.15)
        f.setBold(True)
        self.peer_name.setFont(f)
        self.peer_state = QLabel()
        self.peer_state.setStyleSheet("color: palette(placeholder-text); font-size: 9pt;")
        names.addWidget(self.peer_name)
        names.addWidget(self.peer_state)
        top.addLayout(names, 1)
        more = QToolButton()
        more.setIcon(QIcon.fromTheme("overflow-menu", QIcon.fromTheme("application-menu")))
        more.setAutoRaise(True)
        more.clicked.connect(lambda: self.chat_menu(None, None))
        top.addWidget(more)
        cv.addLayout(top)
        self.pinned = QLabel()
        self.pinned.setWordWrap(True)
        self.pinned.setStyleSheet("background: palette(alternate-base); border-radius: 8px; padding: 6px 10px;")
        cv.addWidget(self.pinned)
        self.request_bar = QFrame()
        self.request_bar.setObjectName("group")
        rb = QHBoxLayout(self.request_bar)
        rb.setContentsMargins(12, 8, 12, 8)
        self.request_text = QLabel()
        self.request_text.setWordWrap(True)
        accept = QPushButton(_("Accept"))
        accept.setDefault(True)
        accept.clicked.connect(self.accept_current)
        decline = QPushButton(_("Decline"))
        decline.clicked.connect(self.decline_current)
        rb.addWidget(self.request_text, 1)
        rb.addWidget(decline)
        rb.addWidget(accept)
        cv.addWidget(self.request_bar)
        self.msgs = QVBoxLayout()
        self.msgs.setSpacing(6)
        self.msgs.addStretch(1)
        host = QWidget()
        host.setLayout(self.msgs)
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.NoFrame)
        self.scroll.setWidget(host)
        cv.addWidget(self.scroll, 1)
        bottom = QHBoxLayout()
        attach = QToolButton()
        attach.setIcon(QIcon.fromTheme("mail-attachment", QIcon.fromTheme("document-open")))
        attach.setToolTip(_("Photo or file"))
        attach.clicked.connect(self.attach)
        self.entry = QLineEdit()
        self.entry.setPlaceholderText(_("Message…  (Enter to send)"))
        self.entry.setMinimumHeight(34)
        self.entry.returnPressed.connect(self.send)
        self.entry.textEdited.connect(self.on_typing)
        send = QPushButton(QIcon.fromTheme("document-send"), _("Send"))
        send.clicked.connect(self.send)
        bottom.addWidget(attach)
        bottom.addWidget(self.entry, 1)
        bottom.addWidget(send)
        self.bottom_bar = QWidget()
        self.bottom_bar.setLayout(bottom)
        bottom.setContentsMargins(0, 0, 0, 0)

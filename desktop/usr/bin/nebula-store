#!/usr/bin/env python3
"""Nebula Store — curated apps and search across Arch and Flathub (native Qt).

Install and remove right in the window with a progress bar: Arch packages through
pkexec (the system asks for your password in a normal dialog), Flathub apps per user.
"""
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/nebulaos")
from nebula_qt import _, QIcon, app, background, fit, tile  # noqa: E402
from PySide6.QtCore import QProcess, QSize, Qt  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QDialog, QFrame, QGridLayout, QHBoxLayout, QLabel, QLineEdit, QListWidget, QListWidgetItem,
    QMainWindow, QMessageBox, QPlainTextEdit, QProgressBar, QPushButton, QScrollArea, QVBoxLayout, QWidget,
)

CATALOG = Path("/usr/share/nebulaos/store.json")
FLATHUB = "https://dl.flathub.org/repo/flathub.flatpakrepo"
SECTION_ICONS = {"Popular": ("starred", "#f59e0b"), "Games": ("input-gaming", "#8b5cf6"),
                 "Chat and internet": ("mail-message", "#0ea5e9"), "Browsers": ("internet-web-browser", "#2563eb"),
                 "Media and creativity": ("applications-multimedia", "#ec4899"),
                 "Development": ("applications-development", "#14b8a6"), "Office and study": ("x-office-document", "#f97316"),
                 "Security": ("security-high", "#dc2626"), "System tools": ("preferences-system", "#64748b")}
PERCENT = re.compile(r"(\d{1,3})%")


def installed_pacman():
    try:
        return set(subprocess.run(["pacman", "-Qq"], capture_output=True, text=True).stdout.split())
    except OSError:
        return set()


def installed_flatpak():
    if not shutil.which("flatpak"):
        return set()
    try:
        out = subprocess.run(["flatpak", "list", "--app", "--columns=application"],
                             capture_output=True, text=True, timeout=20).stdout
        return set(out.split())
    except (OSError, subprocess.TimeoutExpired):
        return set()


def search(query):
    out = []
    try:
        p = subprocess.run(["pacman", "-Ss", query], capture_output=True, text=True, timeout=30)
        lines = p.stdout.splitlines()
        for i in range(0, len(lines) - 1, 2):
            head = lines[i].split()
            if head:
                name = head[0].split("/", 1)[-1]
                out.append({"source": "arch", "id": name, "name": name, "desc": lines[i + 1].strip()})
    except (OSError, subprocess.TimeoutExpired):
        pass
    out = out[:48]
    if shutil.which("flatpak"):
        try:
            p = subprocess.run(["flatpak", "search", "--columns=application,name,description", query],
                               capture_output=True, text=True, timeout=30)
            for line in p.stdout.splitlines():
                parts = line.split("\t")
                if len(parts) >= 3 and "." in parts[0]:
                    out.append({"source": "flathub", "id": parts[0], "name": parts[1], "desc": parts[2]})
        except (OSError, subprocess.TimeoutExpired):
            pass
    return out[:80]


def steps(item, remove):
    """Commands for one install/remove, run one after another."""
    pid = item["id"]
    if item["source"] == "arch":
        if remove:
            return [["pkexec", "pacman", "-Rns", "--noconfirm", pid]]
        return [["pkexec", "pacman", "-S", "--needed", "--noconfirm", pid]]
    if remove:
        return [["flatpak", "uninstall", "--user", "-y", "--noninteractive", pid]]
    return [["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", FLATHUB],
            ["flatpak", "install", "--user", "-y", "--noninteractive", "flathub", pid]]


def launch(item):
    """Open an installed app."""
    if item["source"] == "flathub":
        subprocess.Popen(["flatpak", "run", item["id"]])
        return
    try:
        files = subprocess.run(["pacman", "-Qlq", item["id"]], capture_output=True, text=True).stdout.split()
    except OSError:
        files = []
    desktop = [f for f in files if f.startswith("/usr/share/applications/") and f.endswith(".desktop")]
    if desktop:
        subprocess.Popen(["kioclient", "exec", desktop[0]])
    elif shutil.which(item["id"]):
        subprocess.Popen(["konsole", "--profile", "Nebula", "-e", item["id"]])


class Progress(QDialog):
    """Runs the steps with a progress bar; the details are one click away."""

    def __init__(self, parent, item, remove):
        super().__init__(parent)
        self.item, self.remove, self.ok = item, remove, False
        self.queue = steps(item, remove)
        self.retried = False
        self.setWindowTitle(item["name"])
        self.setMinimumWidth(460)
        v = QVBoxLayout(self)
        self.label = QLabel((_("Removing {}…") if remove else _("Installing {}…")).format(item["name"]))
        f = self.label.font()
        f.setBold(True)
        self.label.setFont(f)
        v.addWidget(self.label)
        self.bar = QProgressBar()
        self.bar.setRange(0, 0)
        v.addWidget(self.bar)
        self.hint = QLabel(_("The system may ask for your password.") if item["source"] == "arch" else "")
        self.hint.setStyleSheet("color: palette(placeholder-text);")
        v.addWidget(self.hint)
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setMaximumBlockCount(400)
        self.log.setFixedHeight(150)
        self.log.hide()
        details = QPushButton(_("Details"))
        details.setFlat(True)
        details.clicked.connect(lambda: self.log.setVisible(not self.log.isVisible()))
        self.close_btn = QPushButton(_("Close"))
        self.close_btn.setEnabled(False)
        self.close_btn.clicked.connect(self.accept)
        row = QHBoxLayout()
        row.addWidget(details)
        row.addStretch(1)
        row.addWidget(self.close_btn)
        v.addWidget(self.log)
        v.addLayout(row)
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.read)
        self.proc.finished.connect(self.step_done)
        self.next_step()

    def next_step(self):
        cmd = self.queue.pop(0)
        self.log.appendPlainText("$ " + " ".join(cmd))
        self.proc.start(cmd[0], cmd[1:])

    def read(self):
        text = bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        self.log.appendPlainText(text.rstrip())
        found = PERCENT.findall(text)
        if found:
            self.bar.setRange(0, 100)
            self.bar.setValue(min(100, int(found[-1])))

    def step_done(self, code, _status):
        log = self.log.toPlainText()
        if code != 0 and self.item["source"] == "arch" and not self.remove and not self.retried \
                and ("404" in log or "target not found" in log or "failed retrieving" in log):
            # Package lists are old: update the system together with the app (the Arch way).
            self.retried = True
            self.label.setText(_("Updating the package lists and installing {}…").format(self.item["name"]))
            self.queue = [["pkexec", "pacman", "-Syu", "--needed", "--noconfirm", self.item["id"]]]
            self.next_step()
            return
        if code == 0 and self.queue:
            self.next_step()
            return
        self.ok = code == 0
        self.bar.setRange(0, 100)
        self.bar.setValue(100 if self.ok else 0)
        if self.ok:
            self.label.setText((_("{} is removed.") if self.remove else _("{} is installed.")).format(self.item["name"]))
            self.hint.setText("")
        else:
            self.label.setText(_("Something went wrong."))
            self.hint.setText(_("Cancelled, or no internet. Open Details to see why."))
            self.log.show()
        self.close_btn.setEnabled(True)
        self.close_btn.setDefault(True)

    def reject(self):
        if self.proc.state() == QProcess.NotRunning:
            super().reject()


class AppCard(QFrame):
    def __init__(self, store, item):
        super().__init__()
        self.store, self.item = store, item
        self.setObjectName("group")
        lay = QHBoxLayout(self)
        lay.setContentsMargins(12, 10, 12, 10)
        lay.setSpacing(12)
        icon = QLabel()
        guess = item.get("icon") or item["id"].split(".")[-1].lower()
        ic = QIcon.fromTheme(item["id"], QIcon.fromTheme(guess, QIcon.fromTheme("application-x-executable")))
        icon.setPixmap(ic.pixmap(QSize(40, 40)))
        icon.setFixedSize(44, 44)
        lay.addWidget(icon, 0, Qt.AlignTop)
        text = QVBoxLayout()
        text.setSpacing(2)
        name = QLabel(item["name"])
        f = name.font()
        f.setBold(True)
        name.setFont(f)
        desc = QLabel(_(item.get("desc", "")))
        desc.setWordWrap(True)
        desc.setStyleSheet("color: palette(placeholder-text);")
        src = QLabel("Flathub" if item["source"] == "flathub" else "Arch")
        src.setStyleSheet("color: palette(placeholder-text); font-size: 8pt;")
        text.addWidget(name)
        text.addWidget(desc)
        text.addWidget(src)
        lay.addLayout(text, 1)
        self.buttons = QVBoxLayout()
        lay.addLayout(self.buttons)
        self.draw_buttons()

    def draw_buttons(self):
        while self.buttons.count():
            w = self.buttons.takeAt(0).widget()
            if w:
                w.deleteLater()
        if self.store.is_installed(self.item):
            open_btn = QPushButton(_("Open"))
            open_btn.setDefault(True)
            open_btn.clicked.connect(lambda: launch(self.item))
            rm = QPushButton(_("Remove"))
            rm.setFlat(True)
            rm.clicked.connect(lambda: self.run(remove=True))
            self.buttons.addWidget(open_btn)
            self.buttons.addWidget(rm)
        else:
            btn = QPushButton(_("Install"))
            btn.setDefault(True)
            btn.clicked.connect(lambda: self.run(remove=False))
            self.buttons.addWidget(btn)

    def run(self, remove):
        if remove and QMessageBox.question(self, "Nebula Store",
                                           _("Remove {}?").format(self.item["name"])) != QMessageBox.Yes:
            return
        dlg = Progress(self, self.item, remove)
        dlg.exec()
        if dlg.ok:
            self.store.refresh_installed()
            self.draw_buttons()


class Store(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("App Store")
        try:
            self.catalog = json.loads(CATALOG.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            self.catalog = {}
        self.refresh_installed()

        self.nav = QListWidget()
        self.nav.setObjectName("nav")
        self.nav.setFixedWidth(230)
        self.nav.setIconSize(QSize(24, 24))
        for section in self.catalog:
            glyph, color = SECTION_ICONS.get(section, ("applications-other", "#64748b"))
            item = QListWidgetItem(tile(glyph, color), _(section))
            item.setSizeHint(QSize(0, 38))
            self.nav.addItem(item)
        item = QListWidgetItem(tile("checkmark", "#16a34a"), _("Installed"))
        item.setSizeHint(QSize(0, 38))
        self.nav.addItem(item)
        self.nav.currentRowChanged.connect(self.show_section)

        self.search = QLineEdit()
        self.search.setPlaceholderText(_("Search apps…"))
        self.search.setClearButtonEnabled(True)
        self.search.returnPressed.connect(self.on_search)
        self.title = QLabel()
        f = self.title.font()
        f.setPointSizeF(f.pointSizeF() * 1.45)
        f.setBold(True)
        self.title.setFont(f)

        self.grid_host = QWidget()
        self.grid = QGridLayout(self.grid_host)
        self.grid.setSpacing(12)
        self.grid.setContentsMargins(0, 0, 0, 0)
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        holder = QWidget()
        hv = QVBoxLayout(holder)
        hv.setContentsMargins(0, 0, 0, 0)
        hv.addWidget(self.grid_host)
        hv.addStretch(1)
        scroll.setWidget(holder)

        right = QWidget()
        rv = QVBoxLayout(right)
        rv.setContentsMargins(24, 18, 24, 12)
        rv.setSpacing(12)
        top = QHBoxLayout()
        top.addWidget(self.title, 1)
        self.search.setMinimumWidth(260)
        top.addWidget(self.search)
        rv.addLayout(top)
        rv.addWidget(scroll, 1)

        body = QWidget()
        lay = QHBoxLayout(body)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)
        lay.addWidget(self.nav)
        lay.addWidget(right, 1)
        self.setCentralWidget(body)
        self.nav.setCurrentRow(0)
        fit(self, 1000, 700)

    def refresh_installed(self):
        self.have_arch = installed_pacman()
        self.have_flat = installed_flatpak()

    def is_installed(self, item):
        return item["id"] in (self.have_arch if item["source"] == "arch" else self.have_flat)

    def fill(self, items):
        while self.grid.count():
            w = self.grid.takeAt(0).widget()
            if w:
                w.deleteLater()
        if not items:
            self.grid.addWidget(QLabel(_("Nothing found")), 0, 0)
        for i, item in enumerate(items):
            self.grid.addWidget(AppCard(self, item), i // 2, i % 2)

    def show_section(self, row):
        if row < 0:
            return
        sections = list(self.catalog)
        if row >= len(sections):
            self.title.setText(_("Installed"))
            seen, items = set(), []
            for apps in self.catalog.values():
                for a in apps:
                    if a["id"] not in seen and self.is_installed(a):
                        seen.add(a["id"])
                        items.append(a)
            self.fill(items)
            return
        self.title.setText(_(sections[row]))
        self.fill(self.catalog[sections[row]])

    def on_search(self):
        query = self.search.text().strip()
        if not query:
            self.show_section(self.nav.currentRow())
            return
        self.title.setText(_("Results for “{}”: {}").format(query, "…"))

        def done(results):
            results = results if isinstance(results, list) else []
            self.title.setText(_("Results for “{}”: {}").format(query, len(results)))
            self.fill(results)
        background(lambda: search(query), done)


def main():
    a = app("nebula-store", "nebula-store")
    w = Store()
    w.show()
    return a.exec()


if __name__ == "__main__":
    sys.exit(main())

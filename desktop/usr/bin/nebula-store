def ui_lang():
    try:
        return (Path.home() / ".config/nebulaos/lang").read_text().strip() or "en"
    except OSError:
        return os.environ.get("LANG", "en")[:2]


# ---------------------------------------------------------------- catalog
def appstream_dir():
    for d in APPSTREAM_DIRS:
        if (d / "appstream.xml.gz").exists() or (d / "appstream.xml").exists():
            return d
    return None


def localized(comp, tag, lang):
    best = None
    for el in comp.findall(tag):
        l = el.get(XML_LANG)
        if l is None and best is None:
            best = el
        elif l and l.split("_")[0] == lang:
            return el
    return best


def text_of(el):
    if el is None:
        return ""
    parts = []
    for child in el.iter():
        if child.tag in ("p", "li") and child.text:
            parts.append(("• " if child.tag == "li" else "") + " ".join(child.text.split()))
    return "\n\n".join(parts) if parts else " ".join((el.text or "").split())


def load_catalog():
    """[{id, name, summary, desc, dev, cats, icon, shots, license, homepage}] from Flathub appstream."""
    d = appstream_dir()
    if not d:
        return []
    src = d / "appstream.xml.gz" if (d / "appstream.xml.gz").exists() else d / "appstream.xml"
    lang = ui_lang()
    cache = CACHE / f"flathub-{lang}.json"
    try:
        if cache.exists() and cache.stat().st_mtime >= src.stat().st_mtime:
            return json.loads(cache.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        pass
    opener = gzip.open if src.suffix == ".gz" else open
    with opener(src, "rb") as fh:
        root = ET.parse(fh).getroot()
    apps = []
    for c in root.findall("component"):
        if c.get("type") not in ("desktop-application", "desktop"):
            continue
        cid = c.findtext("id") or ""
        name = localized(c, "name", lang)
        if not cid or name is None:
            continue
        icon = ""
        for size in ("128x128", "64x64"):
            for ic in c.findall("icon"):
                if ic.get("type") == "cached" and (d / "icons" / size / (ic.text or "")).exists():
                    icon = str(d / "icons" / size / ic.text)
                    break
            if icon:
                break
        shots = []
        for s in c.findall("screenshots/screenshot"):
            imgs = [(int(i.get("width") or 0), i.text) for i in s.findall("image") if i.get("type") == "thumbnail"]
            imgs = [x for x in imgs if 500 <= x[0] <= 1300] or imgs
            if imgs:
                shots.append(sorted(imgs)[0][1])
        summary = localized(c, "summary", lang)
        apps.append({
            "id": cid.removesuffix(".desktop"), "source": "flathub",
            "name": (name.text or "").strip(),
            "summary": (summary.text or "").strip() if summary is not None else "",
            "desc": text_of(localized(c, "description", lang)),
            "dev": c.findtext("developer/name") or c.findtext("developer_name") or "",
            "cats": [x.text for x in c.findall("categories/category") if x.text],
            "icon": icon, "shots": shots[:5],
            "license": c.findtext("project_license") or "",
            "homepage": next((u.text for u in c.findall("url") if u.get("type") == "homepage"), ""),
            "keywords": " ".join(k.text or "" for k in c.findall("keywords/keyword")),
        })
    apps.sort(key=lambda a: a["name"].lower())
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        cache.write_text(json.dumps(apps, ensure_ascii=False), encoding="utf-8")
    except OSError:
        pass
    return apps


def installed_flatpak():
    if not shutil.which("flatpak"):
        return set()
    try:
        out = subprocess.run(["flatpak", "list", "--app", "--columns=application"],
                             capture_output=True, text=True, timeout=20).stdout
        return set(out.split())
    except (OSError, subprocess.TimeoutExpired):
        return set()


def installed_pacman():
    try:
        return set(subprocess.run(["pacman", "-Qq"], capture_output=True, text=True).stdout.split())
    except OSError:
        return set()


def flatpak_updates():
    try:
        out = subprocess.run(["flatpak", "remote-ls", "--updates", "--app", "--columns=application"],
                             capture_output=True, text=True, timeout=60).stdout
        return [x for x in out.split() if "." in x]
    except (OSError, subprocess.TimeoutExpired):
        return []


def pacman_search(query):
    out = []
    try:
        lines = subprocess.run(["pacman", "-Ss", query], capture_output=True, text=True, timeout=30).stdout.splitlines()
        for i in range(0, len(lines) - 1, 2):
            head = lines[i].split()
            if head:
                name = head[0].split("/", 1)[-1]
                out.append({"source": "arch", "id": name, "name": name, "summary": lines[i + 1].strip(),
                            "desc": lines[i + 1].strip(), "dev": "Arch Linux", "cats": [], "icon": "", "shots": []})
    except (OSError, subprocess.TimeoutExpired):
        pass
    return out[:30]


def cached_image(url, folder="shots"):
    """Download once into ~/.cache/nebulaos/<folder>, return the local path."""
    d = CACHE / folder
    d.mkdir(parents=True, exist_ok=True)
    path = d / re.sub(r"[^A-Za-z0-9._-]", "_", url[-120:])
    if not path.exists():
        req = urllib.request.Request(url, headers={"User-Agent": "NebulaOS-AppStore"})
        with urllib.request.urlopen(req, timeout=20) as r:
            path.write_bytes(r.read(6_000_000))
    return str(path)


# ---------------------------------------------------------------- install / remove
def steps(item, remove):
    pid = item["id"]
    if item["source"] == "arch":
        return [["pkexec", "pacman", "-Rns", "--noconfirm", pid]] if remove else \
               [["pkexec", "pacman", "-S", "--needed", "--noconfirm", pid]]
    if remove:
        return [["flatpak", "uninstall", "-y", "--noninteractive", pid]]
    return [["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", FLATHUB],
            ["flatpak", "install", "--user", "-y", "--noninteractive", "flathub", pid]]


def launch(item):
    if item["source"] == "flathub":
        subprocess.Popen(["flatpak", "run", item["id"]])
        return
    try:
        files = subprocess.run(["pacman", "-Qlq", item["id"]], capture_output=True, text=True).stdout.split()
    except OSError:
        files = []
    desktop = [f for f in files if f.startswith("/usr/share/applications/") and f.endswith(".desktop")]
    if desktop:
        subprocess.Popen(["kioclient", "exec", desktop[0]])
    elif shutil.which(item["id"]):
        subprocess.Popen(["konsole", "--profile", "Nebula", "-e", item["id"]])


class Progress(QDialog):
    def __init__(self, parent, item, remove, queue=None):
        super().__init__(parent)
        self.item, self.remove, self.ok, self.retried = item, remove, False, False
        self.queue = queue or steps(item, remove)
        self.setWindowTitle(item["name"])
        self.setMinimumWidth(460)
        v = QVBoxLayout(self)
        self.label = QLabel((_("Removing {}…") if remove else _("Installing {}…")).format(item["name"]))
        f = self.label.font()
        f.setBold(True)
        self.label.setFont(f)
        v.addWidget(self.label)
        self.bar = QProgressBar()
        self.bar.setRange(0, 0)
        v.addWidget(self.bar)
        self.hint = QLabel(_("The system may ask for your password.") if item["source"] == "arch" else "")
        self.hint.setStyleSheet("color: palette(placeholder-text);")
        v.addWidget(self.hint)
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setMaximumBlockCount(400)
        self.log.setFixedHeight(150)
        self.log.hide()
        details = QPushButton(_("Details"))
        details.setFlat(True)
        details.clicked.connect(lambda: self.log.setVisible(not self.log.isVisible()))
        self.close_btn = QPushButton(_("Close"))
        self.close_btn.setEnabled(False)
        self.close_btn.clicked.connect(self.accept)
        row = QHBoxLayout()
        row.addWidget(details)
        row.addStretch(1)
        row.addWidget(self.close_btn)
        v.addWidget(self.log)
        v.addLayout(row)
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.read)
        self.proc.finished.connect(self.step_done)
        self.next_step()

    def next_step(self):
        cmd = self.queue.pop(0)
        self.log.appendPlainText("$ " + " ".join(cmd))
        self.proc.start(cmd[0], cmd[1:])

    def read(self):
        text = bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        self.log.appendPlainText(text.rstrip())
        found = PERCENT.findall(text)
        if found:
            self.bar.setRange(0, 100)
            self.bar.setValue(min(100, int(found[-1])))

    def step_done(self, code, _status):
        log = self.log.toPlainText()
        if code != 0 and self.item["source"] == "arch" and not self.remove and not self.retried \
                and ("404" in log or "target not found" in log or "failed retrieving" in log):
            self.retried = True
            self.label.setText(_("Updating the package lists and installing {}…").format(self.item["name"]))
            self.queue = [["pkexec", "pacman", "-Syu", "--needed", "--noconfirm", self.item["id"]]]
            self.next_step()
            return
        if code == 0 and self.queue:
            self.next_step()
            return
        self.ok = code == 0
        self.bar.setRange(0, 100)
        self.bar.setValue(100 if self.ok else 0)
        if self.ok:
            self.label.setText((_("{} is removed.") if self.remove else _("{} is installed.")).format(self.item["name"]))
            self.hint.setText("")
        else:
            self.label.setText(_("Something went wrong."))
            self.hint.setText(_("Cancelled, or no internet. Open Details to see why."))
            self.log.show()
        self.close_btn.setEnabled(True)
        self.close_btn.setDefault(True)

    def reject(self):
        if self.proc.state() == QProcess.NotRunning:
            super().reject()


# ---------------------------------------------------------------- widgets
def app_icon(item, size):
    if item.get("icon") and Path(item["icon"]).exists():
        return QPixmap(item["icon"]).scaled(size, size, Qt.KeepAspectRatio, Qt.SmoothTransformation)
    ic = QIcon.fromTheme(item["id"], QIcon.fromTheme(item.get("theme_icon") or item["id"].split(".")[-1].lower(),
                                                     QIcon.fromTheme("application-x-executable")))
    return ic.pixmap(QSize(size, size))


def heading(text, scale=1.45):
    lbl = QLabel(text)
    f = lbl.font()
    f.setPointSizeF(f.pointSizeF() * scale)
    f.setBold(True)
    lbl.setFont(f)
    return lbl


def muted(text, wrap=True):
    lbl = QLabel(text)
    lbl.setWordWrap(wrap)
    lbl.setStyleSheet("color: palette(placeholder-text);")
    return lbl


class Elided(QLabel):
    """One muted line that shortens itself with … to the width it gets (never pushes the button out)."""

    def __init__(self, text):
        super().__init__()
        self.full = text
        self.setStyleSheet("color: palette(placeholder-text);")
        self.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Preferred)
        self.setToolTip(text)

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.setText(self.fontMetrics().elidedText(self.full, Qt.ElideRight, max(10, self.width())))


class Tile(QFrame):
    """App tile: icon, name, one-line summary, Get/Open button. Click opens the app page."""

    def __init__(self, store, item):
        super().__init__()
        self.store, self.item = store, item
        self.setObjectName("group")
        self.setCursor(Qt.PointingHandCursor)
        self.setMinimumWidth(240)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        h = QHBoxLayout(self)
        h.setContentsMargins(12, 10, 12, 10)
        h.setSpacing(12)
        icon = QLabel()
        icon.setPixmap(app_icon(item, 52))
        icon.setFixedSize(56, 56)
        h.addWidget(icon)
        text = QVBoxLayout()
        text.setSpacing(1)
        name = QLabel(item["name"])
        f = name.font()
        f.setBold(True)
        name.setFont(f)
        name.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Preferred)
        summary = Elided(item.get("summary", ""))
        text.addWidget(name)
        text.addWidget(summary)
        h.addLayout(text, 1)
        installed = store.is_installed(item)
        btn = QPushButton(_("Open") if installed else _("Get"))
        btn.setDefault(not installed)
        btn.setMinimumWidth(max(88, btn.sizeHint().width() + 12))
        btn.clicked.connect(lambda: store.primary_action(item))
        h.addWidget(btn, 0, Qt.AlignVCenter)

    def mouseReleaseEvent(self, _e):
        self.store.open_app(self.item)


class Store(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("App Store")
        self.catalog, self.by_id = [], {}
        try:
            self.curated = json.loads(CURATED.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            self.curated = {}
        self.refresh_installed()

        self.nav = QListWidget()
        self.nav.setObjectName("nav")
        self.nav.setFixedWidth(230)
        self.nav.setIconSize(QSize(24, 24))
        self.pages = [("Discover", "starred", "#f59e0b", None), ("Starter packs", "package-x-generic", "", "packs")] + \
                     [(t, i, c, cat) for t, cat, i, c in CATEGORIES] + \
                     [("Installed", "checkmark", "#16a34a", "installed"), ("Updates", "update-none", "#0a84ff", "updates")]
        for title, icon, color, _k in self.pages:
            item = QListWidgetItem(tile(icon, color), _(title))
            item.setSizeHint(QSize(0, 38))
            self.nav.addItem(item)
        self.nav.currentRowChanged.connect(self.show_nav)

        self.search = QLineEdit()
        self.search.setPlaceholderText(_("Search apps…"))
        self.search.setClearButtonEnabled(True)
        self.search.setMinimumWidth(320)
        self.search_timer = QTimer(self)
        self.search_timer.setSingleShot(True)
        self.search_timer.timeout.connect(self.on_search)
        self.search.textChanged.connect(lambda _t: self.search_timer.start(300))
        self.back_btn = QPushButton("‹ " + _("Back"))
        self.back_btn.setFlat(True)
        self.back_btn.hide()
        self.back_btn.clicked.connect(self.go_back)
        top = QHBoxLayout()
        top.setContentsMargins(24, 14, 24, 6)
        top.addWidget(self.back_btn)
        top.addStretch(1)
        top.addWidget(self.search)

        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.NoFrame)
        right = QWidget()
        rv = QVBoxLayout(right)
        rv.setContentsMargins(0, 0, 0, 0)
        rv.setSpacing(0)
        rv.addLayout(top)
        rv.addWidget(self.scroll, 1)
        body = QWidget()
        lay = QHBoxLayout(body)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)
        lay.addWidget(self.nav)
        lay.addWidget(right, 1)
        self.setCentralWidget(body)
        self.history = []
        self.scroll.setWidget(self.loading_page())
        fit(self, 1180, 780)
        if appstream_dir():
            background(load_catalog, self.got_catalog)
        else:
            self.fetch_catalog()

    # ---------- data ----------
    def fetch_catalog(self):
        """First start: add Flathub and download its catalog."""
        self.proc = QProcess(self)
        self.proc.finished.connect(lambda *_a: background(load_catalog, self.got_catalog))
        self.proc.start("sh", ["-c", f"flatpak remote-add --user --if-not-exists flathub {FLATHUB} && "
                                     "flatpak update --user --appstream -y flathub"])

    def got_catalog(self, apps):
        self.catalog = apps if isinstance(apps, list) else []
        self.by_id = {a["id"]: a for a in self.catalog}
        if self.nav.currentRow() < 0:
            self.nav.setCurrentRow(0)
        else:
            self.show_nav(self.nav.currentRow())

    def refresh_installed(self):
        self.have_flat = installed_flatpak()
        self.have_arch = installed_pacman()

    def is_installed(self, item):
        return item["id"] in (self.have_arch if item["source"] == "arch" else self.have_flat)

    def resolve(self, entry):
        """A curated store.json entry → the full catalog entry when Flathub knows it."""
        if entry["source"] == "flathub" and entry["id"] in self.by_id:
            return self.by_id[entry["id"]]
        return {"source": entry["source"], "id": entry["id"], "name": entry["name"],
                "summary": _(entry.get("desc", "")), "desc": _(entry.get("desc", "")),
                "dev": "Arch Linux" if entry["source"] == "arch" else "",
                "cats": [], "icon": "", "shots": [], "theme_icon": entry.get("icon", "")}

    # ---------- navigation ----------
    def set_content(self, widget, push=False):
        if push:
            old = self.scroll.takeWidget()
            if old is not None:
                self.history.append(old)
        else:
            old = self.scroll.takeWidget()
            if old is not None:
                old.deleteLater()
        self.scroll.setWidget(widget)
        self.back_btn.setVisible(bool(self.history))
        self.scroll.verticalScrollBar().setValue(0)

    def go_back(self):
        if self.history:
            old = self.scroll.takeWidget()
            if old is not None:
                old.deleteLater()
            self.scroll.setWidget(self.history.pop())
            self.back_btn.setVisible(bool(self.history))

    def clear_history(self):
        for w in self.history:
            w.deleteLater()
        self.history = []

    def show_nav(self, row):
        if row < 0:
            return
        self.clear_history()
        title, _i, _c, key = self.pages[row]
        if not self.catalog and key not in ("installed", "updates"):
            self.set_content(self.loading_page())
        elif key is None:
            self.set_content(self.discover_page())
        elif key == "packs":
            w, v = self.page_box()
            v.addWidget(heading(_("Starter packs"), 1.7))
            packs = self.bundles()
            if packs:
                v.addWidget(packs)
            v.addStretch(1)
            self.set_content(w)
        elif key == "installed":
            self.set_content(self.installed_page())
        elif key == "updates":
            self.set_content(self.updates_page())
        else:
            self.set_content(self.grid_page(_(title), [a for a in self.catalog if key in a["cats"]]))

    def on_search(self):
        q = self.search.text().strip().lower()
        if not q:
            self.show_nav(max(0, self.nav.currentRow()))
            return
        words = q.split()
        hits = [a for a in self.catalog
                if all(w in (a["name"] + " " + a.get("summary", "") + " " + a.get("keywords", "")).lower() for w in words)]
        hits.sort(key=lambda a: (not a["name"].lower().startswith(q), a["name"].lower()))
        self.clear_history()
        page = self.grid_page(_("Results for “{}”: {}").format(self.search.text().strip(), len(hits)), hits)
        self.set_content(page)
        if len(q) >= 3:
            def got(results):
                if isinstance(results, list) and results and self.search.text().strip().lower() == q:
                    self.append_arch(page, results)
            background(lambda: pacman_search(q), got)

    # ---------- pages ----------
    def page_box(self):
        w = QWidget()
        v = QVBoxLayout(w)
        v.setContentsMargins(24, 6, 24, 24)
        v.setSpacing(14)
        return w, v

    def loading_page(self):
        w, v = self.page_box()
        v.addStretch(1)
        lbl = heading(_("Loading the catalog…"), 1.2)
        lbl.setAlignment(Qt.AlignCenter)
        v.addWidget(lbl)
        sub = muted(_("The first start downloads the Flathub catalog. It takes a minute."))
        sub.setAlignment(Qt.AlignCenter)
        v.addWidget(sub)
        v.addStretch(2)
        return w

    def tiles(self, items, columns=3):
        host = QWidget()
        g = QGridLayout(host)
        g.setContentsMargins(0, 0, 0, 0)
        g.setSpacing(12)
        for i, item in enumerate(items):
            g.addWidget(Tile(self, item), i // columns, i % columns)
        for c in range(columns):
            g.setColumnStretch(c, 1)
        return host

    def featured(self):
        picks = [self.by_id[x] for x in ("org.blender.Blender", "com.obsproject.Studio", "org.kde.krita",
                                         "com.valvesoftware.Steam", "md.obsidian.Obsidian", "org.videolan.VLC",
                                         "org.inkscape.Inkscape", "com.spotify.Client") if x in self.by_id]
        return picks[date.today().toordinal() % len(picks)] if picks else None

    def hero(self, item):
        card = QFrame()
        card.setObjectName("hero")
        card.setStyleSheet("QFrame#hero { background: palette(highlight); border-radius: 16px; }"
                           "QFrame#hero QLabel { color: palette(highlighted-text); background: transparent; }")
        card.setCursor(Qt.PointingHandCursor)
        card.mouseReleaseEvent = lambda _e: self.open_app(item)
        h = QHBoxLayout(card)
        h.setContentsMargins(28, 24, 28, 24)
        h.setSpacing(22)
        icon = QLabel()
        icon.setPixmap(app_icon(item, 112))
        h.addWidget(icon)
        text = QVBoxLayout()
        kicker = QLabel(_("App of the day").upper())
        f = kicker.font()
        f.setPointSizeF(f.pointSizeF() * 0.8)
        f.setBold(True)
        kicker.setFont(f)
        text.addWidget(kicker)
        text.addWidget(heading(item["name"], 1.9))
        s = QLabel(item.get("summary", ""))
        s.setWordWrap(True)
        text.addWidget(s)
        text.addStretch(1)
        h.addLayout(text, 1)
        btn = QPushButton(_("Open") if self.is_installed(item) else _("Get"))
        btn.setFixedWidth(110)
        btn.clicked.connect(lambda: self.primary_action(item))
        h.addWidget(btn, 0, Qt.AlignVCenter)
        return card

    def bundles(self, limit=None):
        host = QWidget()
        g = QGridLayout(host)
        g.setContentsMargins(0, 0, 0, 0)
        g.setSpacing(12)
        n = 0
        for title, ids in BUNDLES[:limit]:
            items = list({i: self.by_id[i] for i in ids if i in self.by_id}.values())
            if len(items) < 2:
                continue
            missing = [it for it in items if not self.is_installed(it)]
            card = QFrame()
            card.setObjectName("group")
            v = QVBoxLayout(card)
            v.setContentsMargins(14, 12, 14, 12)
            name = QLabel(_(title))
            f = name.font()
            f.setBold(True)
            name.setFont(f)
            v.addWidget(name)
            icons = QHBoxLayout()
            icons.setSpacing(6)
            for it in items:
                ic = QLabel()
                ic.setPixmap(app_icon(it, 36))
                ic.setToolTip(it["name"])
                icons.addWidget(ic)
            icons.addStretch(1)
            v.addLayout(icons)
            names = muted(", ".join(it["name"] for it in items))
            v.addWidget(names)
            btn = QPushButton(_("Get all ({})").format(len(missing)) if missing else _("Installed"))
            btn.setEnabled(bool(missing))
            btn.clicked.connect(lambda _c=False, t=title, m=missing: self.install_bundle(t, m))
            v.addWidget(btn, 0, Qt.AlignRight)
            g.addWidget(card, n // 3, n % 3)
            n += 1
        for c in range(3):
            g.setColumnStretch(c, 1)
        return host if n else None

    def install_bundle(self, title, items):
        if not items:
            return
        # one flatpak call for the whole pack: shared runtimes are downloaded once
        queue = steps(items[0], False)[:1] + [["flatpak", "install", "--user", "-y", "--noninteractive", "flathub"]
                                              + [it["id"] for it in items]]
        dlg = Progress(self, {"name": _(title), "source": "flathub"}, False, queue)
        dlg.exec()
        self.refresh_installed()
        self.show_nav(self.nav.currentRow())

    def row_header(self, title, target_row=None):
        h = QHBoxLayout()
        h.addWidget(heading(title, 1.2))
        h.addStretch(1)
        if target_row is not None:
            more = QPushButton(_("See all"))
            more.setFlat(True)
            more.clicked.connect(lambda: self.nav.setCurrentRow(target_row))
            h.addWidget(more)
        return h

    def discover_page(self):
        w, v = self.page_box()
        v.addWidget(heading(_("Discover"), 1.7))
        feat = self.featured()
        if feat:
            v.addWidget(self.hero(feat))
        packs = self.bundles(limit=6)
        if packs:
            v.addLayout(self.row_header(_("Starter packs"), 1))
            v.addWidget(packs)
        popular = [self.resolve(e) for e in self.curated.get("Popular", [])]
        if popular:
            v.addLayout(self.row_header(_("Popular")))
            v.addWidget(self.tiles(popular[:9]))
        for row, (title, cat, _i, _c) in enumerate(CATEGORIES[:4], start=2):
            apps = [a for a in self.catalog if cat in a["cats"] and a.get("icon") and a.get("shots")]
            if apps:
                import random
                pick = random.Random(date.today().toordinal() + row).sample(apps, min(6, len(apps)))
                v.addLayout(self.row_header(_(title), row))
                v.addWidget(self.tiles(pick))
        v.addStretch(1)
        return w

    def grid_page(self, title, apps, limit=60):
        w, v = self.page_box()
        v.addWidget(heading(title, 1.5))
        if not apps:
            v.addWidget(muted(_("Nothing found")))
        v.addWidget(self.tiles(apps[:limit]))
        if len(apps) > limit:
            more = QPushButton(_("Show more ({})").format(len(apps) - limit))
            more.clicked.connect(lambda: self.set_content(self.grid_page(title, apps, limit + 90)))
            v.addWidget(more, 0, Qt.AlignHCenter)
        v.addStretch(1)
        w.extra = v
        return w

    def append_arch(self, page, results):
        v = page.extra
        v.insertLayout(v.count() - 1, self.row_header(_("Arch packages")))
        v.insertWidget(v.count() - 1, self.tiles(results))

    def installed_page(self):
        w, v = self.page_box()
        v.addWidget(heading(_("Installed"), 1.5))
        apps = [self.by_id.get(x) or {"source": "flathub", "id": x, "name": x.split(".")[-1], "summary": x,
                                      "cats": [], "icon": "", "shots": []} for x in sorted(self.have_flat)]
        curated_arch = {e["id"]: e for sec in self.curated.values() for e in sec if e["source"] == "arch"}
        apps += [self.resolve(e) for i, e in curated_arch.items() if i in self.have_arch]
        if not apps:
            v.addWidget(muted(_("Apps you install appear here.")))
        v.addWidget(self.tiles(apps))
        v.addStretch(1)
        return w

    def updates_page(self):
        w, v = self.page_box()
        v.addWidget(heading(_("Updates"), 1.5))
        status = muted(_("Checking…"))
        v.addWidget(status)
        holder = QVBoxLayout()
        v.addLayout(holder)
        v.addStretch(1)

        def got(ids):
            ids = ids if isinstance(ids, list) else []
            if not ids:
                status.setText(_("All apps are up to date. System updates: Settings → Updates."))
                return
            status.setText(_("Updates available: {}").format(len(ids)))
            btn = QPushButton(_("Update all"))
            btn.setDefault(True)
            btn.clicked.connect(self.update_all)
            holder.addWidget(btn, 0, Qt.AlignLeft)
            holder.addWidget(self.tiles([self.by_id.get(x) or {"source": "flathub", "id": x, "name": x, "summary": "",
                                                               "cats": [], "icon": "", "shots": []} for x in ids]))
        background(flatpak_updates, got)
        return w

    def update_all(self):
        item = {"source": "flathub", "id": "", "name": _("Apps")}
        dlg = Progress(self, item, False, [["flatpak", "update", "-y", "--noninteractive"]])
        dlg.exec()
        self.show_nav(self.nav.currentRow())

    def detail_page(self, item):
        w, v = self.page_box()
        head = QHBoxLayout()
        head.setSpacing(20)
        icon = QLabel()
        icon.setPixmap(app_icon(item, 112))
        head.addWidget(icon, 0, Qt.AlignTop)
        text = QVBoxLayout()
        text.addWidget(heading(item["name"], 1.9))
        text.addWidget(muted(item.get("dev") or ("Flathub" if item["source"] == "flathub" else "Arch Linux")))
        summary = QLabel(item.get("summary", ""))
        summary.setWordWrap(True)
        text.addWidget(summary)
        buttons = QHBoxLayout()
        if self.is_installed(item):
            open_btn = QPushButton(_("Open"))
            open_btn.setDefault(True)
            open_btn.clicked.connect(lambda: launch(item))
            rm = QPushButton(_("Remove"))
            rm.clicked.connect(lambda: self.run(item, True))
            buttons.addWidget(open_btn)
            buttons.addWidget(rm)
        else:
            get = QPushButton(_("Get"))
            get.setDefault(True)
            get.setFixedWidth(120)
            get.clicked.connect(lambda: self.run(item, False))
            buttons.addWidget(get)
        buttons.addStretch(1)
        text.addSpacing(6)
        text.addLayout(buttons)
        head.addLayout(text, 1)
        v.addLayout(head)
        if item.get("shots"):
            strip = QHBoxLayout()
            strip.setSpacing(12)
            for url in item["shots"]:
                lbl = QLabel(_("Loading…"))
                lbl.setFixedSize(460, 288)
                lbl.setAlignment(Qt.AlignCenter)
                lbl.setStyleSheet("background: palette(base); border-radius: 10px; color: palette(placeholder-text);")
                strip.addWidget(lbl)

                def got(path, lbl=lbl):
                    if isinstance(path, str):
                        lbl.setPixmap(QPixmap(path).scaled(460, 288, Qt.KeepAspectRatio, Qt.SmoothTransformation))
                    else:
                        lbl.setText("")
                background(lambda u=url: cached_image(u), got)
            strip.addStretch(1)
            shots = QWidget()
            shots.setLayout(strip)
            sc = QScrollArea()
            sc.setWidget(shots)
            sc.setWidgetResizable(True)
            sc.setFrameShape(QFrame.NoFrame)
            sc.setFixedHeight(310)
            sc.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
            v.addWidget(sc)
        if item.get("desc"):
            v.addWidget(heading(_("About this app"), 1.15))
            d = QLabel(item["desc"])
            d.setWordWrap(True)
            d.setTextInteractionFlags(Qt.TextSelectableByMouse)
            v.addWidget(d)
        info = []
        if item.get("license"):
            info.append(_("License") + ": " + item["license"].split("=")[0].replace("LicenseRef-proprietary",
                                                                                     _("proprietary")))
        info.append(_("Source") + ": " + ("Flathub" if item["source"] == "flathub" else "Arch Linux"))
        if item.get("homepage"):
            info.append(f'<a href="{item["homepage"]}">{_("Website")}</a>')
        meta = QLabel("  ·  ".join(info))
        meta.setOpenExternalLinks(True)
        meta.setStyleSheet("color: palette(placeholder-text);")
        v.addWidget(meta)
        v.addStretch(1)
        return w

    # ---------- actions ----------
    def open_app(self, item):
        self.set_content(self.detail_page(item), push=True)

    def primary_action(self, item):
        if self.is_installed(item):
            launch(item)
        else:
            self.run(item, False)

    def run(self, item, remove):
        if remove and QMessageBox.question(self, "App Store", _("Remove {}?").format(item["name"])) != QMessageBox.Yes:
            return
        dlg = Progress(self, item, remove)
        dlg.exec()
        if dlg.ok:
            self.refresh_installed()
            if self.history:          # on an app page: redraw it
                self.set_content(self.detail_page(item))
            else:
                self.show_nav(self.nav.currentRow())


def main():
    a = app("nebula-store", "nebula-store")
    w = Store()
    w.show()
    return a.exec()


if __name__ == "__main__":
    sys.exit(main())

    QMessageBox, QPlainTextEdit, QProgressBar, QPushButton, QScrollArea, QSizePolicy, QVBoxLayout, QWidget,
)

FLATHUB = "https://dl.flathub.org/repo/flathub.flatpakrepo"
CURATED = Path("/usr/share/nebulaos/store.json")
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "nebulaos"
APPSTREAM_DIRS = [Path.home() / ".local/share/flatpak/appstream/flathub/x86_64/active",

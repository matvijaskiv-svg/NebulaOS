    def page_ai(self):
        p = Page("Assistant", "Local Ollama model: your data never leaves this computer. Super+A opens the assistant.")
        g = p.group()
        conf = CONF / "assistant.conf"
        model_now = ""
        for f in (Path("/etc/nebulaos/assistant.conf"), conf):
            if f.exists():
                for line in f.read_text(encoding="utf-8").splitlines():
                    if line.startswith("model=") and line[6:].strip():
                        model_now = line[6:].strip()
        models = ["qwen2.5:1.5b", "qwen2.5:3b", "qwen2.5:7b", "llama3.2:3b"]
        if model_now and model_now not in models:
            models.insert(0, model_now)

        def choose(i):
            CONF.mkdir(parents=True, exist_ok=True)
            lines = [l for l in conf.read_text(encoding="utf-8").splitlines() if not l.startswith("model=")] \
                if conf.exists() else []
            conf.write_text("\n".join(lines + [f"model={models[i]}"]) + "\n", encoding="utf-8")
            self.toast(_("Model: {}").format(models[i]))
        g.combo("Model", models, models.index(model_now) if model_now in models else 0, choose,
                "Bigger models answer better but need more memory")
        g.action("Download a model", "Downloaded with ollama pull (several GB)", "Download",
                 lambda: in_terminal("ollama", "pull", model_now or models[0]))
        g.action("Open the assistant", "", "Open", lambda: subprocess.Popen(["nebula-ai-overlay"]), primary=True)
        return p

    def page_about(self):

    def page_language(self):
        p = Page("Language and region")
        codes = [c for c, _n in LANGUAGES]
        g = p.group("", "The keyboard layout follows the language (Alt+Shift switches).")
        g.combo("Interface language", [n for _c, n in LANGUAGES], codes.index(current()), self.set_lang)
        g.action("Formats", "Dates, numbers, currency", "Settings…", lambda: kcm("kcm_regionandlang"))
        return p

    def set_lang(self, index):
        code = LANGUAGES[index][0]
        if code != current():
            run("lang", code)
            os.execv(sys.argv[0], sys.argv)

    # ---------- NebulaOS ----------
    def page_features(self):
        p = Page("Mode features")
        envd = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "environment.d"
        g = p.group("Gaming")
        g.switch("MangoHud in all games", "FPS and load on top of games (after re-login)",
                 (envd / "90-mangohud.conf").exists(),
                 lambda on: self.toast(run("game", "mangohud", "on" if on else "off")[1]))
        g.action("Turbo mode", "Pause desktop effects for maximum FPS", "Toggle", lambda: run("perf"))
        g.action("Epic, GOG, Proton-GE, OBS", "Launchers and game recording are in the store", "Store",
                 lambda: subprocess.Popen(["nebula-store"]))
        h = p.group("Hacking", "For your own labs, CTFs and tests you are authorized to run.")
        for lab, desc in [("dvwa", "DVWA — deliberately vulnerable web app"), ("juice-shop", "OWASP Juice Shop"),
                          ("webgoat", "OWASP WebGoat")]:
            h.action(_("Lab {}").format(lab), _(desc) + " · " + _("127.0.0.1 only, needs Docker"), "Start",
                     lambda l=lab: in_terminal("nebula", "lab", "start", l))
        s = p.group("Server")
        s.action("Service status", "", "Show", lambda: in_terminal("nebula", "server", "status"))
        for key, title in [("ssh", "SSH"), ("docker", "Docker"), ("cockpit", "Cockpit (web panel :9090)"),
                           ("web", "nginx web server"), ("db", "PostgreSQL")]:
            s.action(title, "Enable and open its firewall port", "Enable",
                     lambda k=key: in_terminal("nebula", "server", "enable", k))
        r = p.group("Ready-made servers", "Deployed with Docker into /srv/nebula.")
        for tpl, title, desc in [("files", "File sharing", "File Browser, port 8080"),
                                 ("media", "Media server", "Jellyfin, port 8096"),
                                 ("minecraft", "Minecraft server", "Java Edition, port 25565")]:
            r.action(title, desc, "Deploy", lambda t=tpl: in_terminal("nebula", "template", "deploy", t))
        return p


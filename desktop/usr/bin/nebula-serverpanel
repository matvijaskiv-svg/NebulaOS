#!/usr/bin/env python3
"""Server Panel (Server mode): a live dashboard.

Graphs of CPU, memory and network, disk usage, uptime; services with status, on/off
and their logs; Docker containers; ready-made servers; firewall rules.
"""
import os
import shutil
import subprocess
import sys
import time
from collections import deque
from pathlib import Path

sys.path.insert(0, "/usr/lib/nebulaos")
from nebula_qt import _, Meter, Page, QIcon, app, background, fit, in_terminal, tile  # noqa: E402
from PySide6.QtCore import QPointF, QSize, Qt, QTimer  # noqa: E402
from PySide6.QtGui import QColor, QFont, QPainter, QPainterPath, QPen  # noqa: E402
from PySide6.QtCore import QProcess  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QDialog, QFrame, QGridLayout, QHBoxLayout, QLabel, QListWidget, QListWidgetItem, QMainWindow, QMessageBox,
    QPlainTextEdit, QProgressBar, QPushButton, QStackedWidget, QVBoxLayout, QWidget,
)

SERVICES = [  # (key for `nebula server enable`, unit, title, description)
    ("ssh", "sshd", "SSH", "Remote terminal access (port 22)"),
    ("docker", "docker", "Docker", "Containers"),
    ("cockpit", "cockpit.socket", "Cockpit", "Web admin panel on port 9090"),
    ("web", "nginx", "Web server", "nginx on port 80"),
    ("db", "postgresql", "Database", "PostgreSQL"),
    ("vpn", "tailscaled", "Remote access (Tailscale)", "Open your servers from anywhere, no router setup"),
]
TEMPLATES = {  # name: (title, description, theme icons, port, web path or None)
    "media": ("Jellyfin", "Films, series and music on every device", ("jellyfin", "applications-multimedia"), 8096, "/"),
    "immich": ("Immich", "Your own photo library with phone backup", ("immich", "image-x-generic"), 2283, "/"),
    "nextcloud": ("Nextcloud", "Files, contacts and calendar in your own cloud", ("nextcloud", "folder-cloud"), 8082, "/"),
    "vaultwarden": ("Vaultwarden", "Password manager, works with the Bitwarden apps", ("bitwarden", "dialog-password"), 8222, "/"),
    "homeassistant": ("Home Assistant", "Smart home: lights, sensors, automations", ("homeassistant", "go-home"), 8123, "/"),
    "pihole": ("Pi-hole", "Blocks ads on every device at home. Password: nebulaos", ("pi-hole", "security-high"), 8081, "/admin/"),
    "torrent": ("qBittorrent", "Torrents from the browser, downloads in /srv/nebula/torrent", ("qbittorrent", "download"), 8090, "/"),
    "uptime": ("Uptime Kuma", "Watches your sites and servers", ("utilities-system-monitor", "utilities-system-monitor"), 3001, "/"),
    "files": ("File server", "Shared folders in the browser for your home network", ("folder-network", "folder"), 8080, "/"),
    "minecraft": ("Minecraft", "Your own server to play with friends", ("minecraft", "input-gaming"), 25565, None),
}


HELPER = "/usr/lib/nebulaos/server-helper"
SERVICE_ICONS = {"ssh": ("utilities-terminal",), "docker": ("docker", "package-x-generic"),
                 "cockpit": ("cockpit", "computer"), "web": ("nginx", "internet-web-browser"),
                 "db": ("postgresql", "server-database"), "vpn": ("tailscale", "network-vpn")}
SERVICE_BIN = {"ssh": "sshd", "docker": "docker", "cockpit": "cockpit-bridge", "web": "nginx", "db": "postgres",
               "vpn": "tailscale"}


def sh_out(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def local_ip():
    import socket
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("10.255.255.255", 1))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return "127.0.0.1"


def app_icon(names):
    for n in names:
        if QIcon.hasThemeIcon(n):
            return QIcon.fromTheme(n)
    return QIcon.fromTheme("application-x-executable")


def status_text(running, installed):
    return _("Running") if running else (_("Stopped") if installed else _("Not installed"))


class Task(QDialog):
    """Runs the helper through pkexec and shows its steps with a progress bar."""

    def __init__(self, parent, title, cmd):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.setMinimumWidth(520)
        v = QVBoxLayout(self)
        self.label = QLabel(_("The system asks for your password once."))
        f = self.label.font()
        f.setBold(True)
        self.label.setFont(f)
        v.addWidget(self.label)
        self.bar = QProgressBar()
        self.bar.setRange(0, 0)
        v.addWidget(self.bar)
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setMaximumBlockCount(500)
        self.log.setFixedHeight(170)
        self.log.setFont(QFont("monospace", 8))
        v.addWidget(self.log)
        self.close_btn = QPushButton(_("Close"))
        self.close_btn.setEnabled(False)
        self.close_btn.clicked.connect(self.accept)
        v.addWidget(self.close_btn, 0, Qt.AlignRight)
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.read)
        self.proc.finished.connect(self.done)
        self.proc.start(cmd[0], cmd[1:])

    def read(self):
        for line in bytes(self.proc.readAllStandardOutput()).decode(errors="replace").splitlines():
            if "https://login.tailscale.com/" in line and not getattr(self, "opened", False):
                self.opened = True
                url = line[line.index("https://"):].split()[0]
                subprocess.Popen(["xdg-open", url])
                self.label.setText(_("Sign in to Tailscale in the browser that just opened."))
                self.log.appendPlainText(url)
                continue
            if line.startswith("STEP: "):
                text = line[6:]
                for pre in ("Installing ", "Starting ", "Stopping "):
                    if text.startswith(pre) and _(text) == text:
                        text = _(pre + "{}").format(text[len(pre):])
                self.label.setText(_(text))
            elif line.strip():
                self.log.appendPlainText(line)

    def done(self, code, _status):
        self.bar.setRange(0, 100)
        self.bar.setValue(100 if code == 0 else 0)
        self.label.setText(_("Done.") if code == 0 else _("Something went wrong — see the log."))
        self.close_btn.setEnabled(True)
        self.close_btn.setDefault(True)

    def reject(self):
        if self.proc.state() == QProcess.NotRunning:
            super().reject()

def unit_state(unit):
    r = subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True)
    return r.stdout.strip() or "unknown"


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PB"


class Graph(QWidget):
    """A live area graph with its title and current value."""

    def __init__(self, title, color, unit="%", maximum=100.0):
        super().__init__()
        self.title, self.color, self.unit, self.maximum = title, QColor(color), unit, maximum
        self.values = deque([0.0] * 60, maxlen=60)
        self.setMinimumHeight(140)

    def push(self, value):
        self.values.append(value)
        self.update()

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = self.rect().adjusted(1, 1, -1, -1)
        p.setPen(QPen(self.palette().midlight().color(), 1))
        p.setBrush(self.palette().base())
        p.drawRoundedRect(r, 10, 10)
        top = r.top() + 40
        h = r.height() - 52
        top_val = self.maximum if self.unit == "%" else max(max(self.values) * 1.2, 1)
        pts = [QPointF(r.left() + 12 + i * (r.width() - 24) / (len(self.values) - 1),
                       top + h - min(v / top_val, 1) * h) for i, v in enumerate(self.values)]
        area = QPainterPath(QPointF(pts[0].x(), top + h))
        for pt in pts:
            area.lineTo(pt)
        area.lineTo(QPointF(pts[-1].x(), top + h))
        fill = QColor(self.color)
        fill.setAlpha(45)
        p.fillPath(area, fill)
        line = QPainterPath(pts[0])
        for pt in pts[1:]:
            line.lineTo(pt)
        p.setPen(QPen(self.color, 2))
        p.setBrush(Qt.NoBrush)
        p.drawPath(line)
        p.setPen(self.palette().text().color())
        f = QFont(self.font())
        f.setBold(True)
        p.setFont(f)
        p.drawText(r.adjusted(14, 10, -14, 0), Qt.AlignLeft | Qt.AlignTop, _(self.title))
        cur = self.values[-1]
        value = f"{cur:.0f}%" if self.unit == "%" else human(cur) + "/s"
        p.setPen(self.color)
        p.drawText(r.adjusted(14, 10, -14, 0), Qt.AlignRight | Qt.AlignTop, value)
        p.end()


class Logs(QDialog):
    def __init__(self, parent, unit):
        super().__init__(parent)
        self.setWindowTitle(f"{unit} — " + _("Logs"))
        self.resize(900, 520)
        v = QVBoxLayout(self)
        text = QPlainTextEdit()
        text.setReadOnly(True)
        text.setFont(QFont("monospace", 9))
        out = subprocess.run(["journalctl", "-u", unit, "-n", "300", "--no-pager", "-o", "short-iso"],
                             capture_output=True, text=True).stdout
        text.setPlainText(out.strip() or _("No log entries yet."))
        text.moveCursor(text.textCursor().End)
        v.addWidget(text)
        close = QPushButton(_("Close"))
        close.clicked.connect(self.accept)
        v.addWidget(close, 0, Qt.AlignRight)


class Panel(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(_("Server Panel"))
        self.nav = QListWidget()
        self.nav.setObjectName("nav")
        self.nav.setFixedWidth(220)
        self.nav.setIconSize(QSize(24, 24))
        self.stack = QStackedWidget()
        self.builders = [("Overview", "computer", "#e95420", self.page_overview),
                         ("Services", "preferences-system", "#64748b", self.page_services),
                         ("Containers", "package-x-generic", "#0ea5e9", self.page_containers),
                         ("Ready-made servers", "network-server", "#14b8a6", self.page_templates),
                         ("Firewall", "security-high", "#dc2626", self.page_firewall)]
        for title, icon, color, _b in self.builders:
            item = QListWidgetItem(tile(icon, color), _(title))
            item.setSizeHint(QSize(0, 38))
            self.nav.addItem(item)
            self.stack.addWidget(QWidget())
        self.nav.currentRowChanged.connect(self.show_page)
        body = QWidget()
        lay = QHBoxLayout(body)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)
        lay.addWidget(self.nav)
        lay.addWidget(self.stack, 1)
        self.setCentralWidget(body)
        self._cpu = self.cpu_times()
        self._net = self.net_bytes()
        self._t = time.time()
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.sample)
        self.timer.start(1000)
        self.nav.setCurrentRow(0)
        fit(self, 1100, 720)

    def show_page(self, row):
        old = self.stack.widget(row)
        self.stack.insertWidget(row, self.builders[row][3]())
        self.stack.removeWidget(old)
        old.deleteLater()
        self.stack.setCurrentIndex(row)

    # ---------- live numbers ----------
    @staticmethod
    def cpu_times():
        parts = [int(x) for x in Path("/proc/stat").read_text().split("\n", 1)[0].split()[1:]]
        return sum(parts), parts[3] + parts[4]

    @staticmethod
    def net_bytes():
        rx = tx = 0
        for line in Path("/proc/net/dev").read_text().splitlines()[2:]:
            name, data = line.split(":", 1)
            if name.strip() == "lo":
                continue
            f = data.split()
            rx += int(f[0])
            tx += int(f[8])
        return rx, tx

    @staticmethod
    def mem_used():
        d = {}
        for line in Path("/proc/meminfo").read_text().splitlines():
            k, v = line.split(":", 1)
            d[k] = int(v.split()[0])
        return 100 * (1 - d.get("MemAvailable", 0) / max(d.get("MemTotal", 1), 1))

    def sample(self):
        total, idle = self.cpu_times()
        dt, di = total - self._cpu[0], idle - self._cpu[1]
        self._cpu = (total, idle)
        rx, tx = self.net_bytes()
        now = time.time()
        span = max(now - self._t, 0.1)
        drx, dtx = (rx - self._net[0]) / span, (tx - self._net[1]) / span
        self._net, self._t = (rx, tx), now
        if getattr(self, "graphs", None):
            try:
                self.graphs["cpu"].push(100 * (1 - di / dt) if dt else 0)
                self.graphs["mem"].push(self.mem_used())
                self.graphs["down"].push(drx)
                self.graphs["up"].push(dtx)
            except RuntimeError:      # page was rebuilt
                self.graphs = None

    # ---------- pages ----------
    def page_overview(self):
        p = Page("Overview")
        grid = QWidget()
        g = QGridLayout(grid)
        g.setContentsMargins(0, 0, 0, 0)
        g.setSpacing(12)
        self.graphs = {"cpu": Graph("Processor", "#e95420"), "mem": Graph("Memory", "#f6a03d"),
                       "down": Graph("Network in", "#0ea5e9", unit="B"), "up": Graph("Network out", "#14b8a6", unit="B")}
        for i, key in enumerate(("cpu", "mem", "down", "up")):
            g.addWidget(self.graphs[key], i // 2, i % 2)
        p.add(grid)
        info = p.group("This server")
        uptime = float(Path("/proc/uptime").read_text().split()[0])
        load = Path("/proc/loadavg").read_text().split()[:3]
        info.widget(QLabel(_("Up for {} h {} min").format(int(uptime // 3600), int(uptime % 3600 // 60))
                           + "    ·    " + _("Load: {}").format(" ".join(load))))
        du = shutil.disk_usage("/")
        disk = QWidget()
        dv = QVBoxLayout(disk)
        dv.setContentsMargins(0, 4, 0, 4)
        dv.addWidget(QLabel(_("Disk: {} of {} used").format(human(du.used), human(du.total))))
        dv.addWidget(Meter(du.used / du.total))
        info.widget(disk)
        s = p.group("Services")
        row = QWidget()
        h = QHBoxLayout(row)
        h.setContentsMargins(0, 4, 0, 4)
        for _k, unit, title, _d in SERVICES:
            st = unit_state(unit)
            dot = QLabel(f"<span style='color:{'#30a46c' if st == 'active' else '#888'}'>●</span> {_(title)}")
            h.addWidget(dot)
            h.addSpacing(14)
        h.addStretch(1)
        s.widget(row)
        c = p.group()
        c.action("Cockpit", "Full web admin panel: logs, users, storage", "Open",
                 lambda: subprocess.Popen(["xdg-open", "https://localhost:9090"]))
        return p

    def page_containers(self):
        p = Page("Containers", "Docker containers on this server.")
        g = p.group()
        if not shutil.which("docker"):
            g.action("Docker is not installed", "", "Install", lambda: in_terminal("nebula", "server", "enable", "docker"),
                     primary=True)
            return p
        status = QLabel(_("Checking…"))
        g.widget(status)

        def got(out):
            if not isinstance(out, str):
                status.setText(_("Docker is not running."))
                return
            rows = [line.split("\t") for line in out.strip().splitlines() if line.strip()]
            status.setText(_("Containers: {}").format(len(rows)) if rows else _("No containers yet."))
            for name, image, state in [(r + ["", "", ""])[:3] for r in rows]:
                running = state.lower().startswith("up")
                g.action(name, f"{image}  ·  {state}", "Stop" if running else "Start",
                         lambda n=name, run=running: in_terminal("sudo", "docker", "stop" if run else "start", n))
        background(lambda: subprocess.run(["sudo", "-n", "docker", "ps", "-a", "--format",
                                           "{{.Names}}\t{{.Image}}\t{{.Status}}"],
                                          capture_output=True, text=True, timeout=10).stdout, got)
        return p

    # ---------- one-click servers and services ----------
    def run_helper(self, title, args, after=None):
        dlg = Task(self, title, ["pkexec", HELPER] + args)
        dlg.exec()
        if after:
            after()
        self.show_page(self.nav.currentRow())

    def _buttons(self, lay, buttons):
        for text, cb, primary in buttons:
            btn = QPushButton(_(text))
            btn.setDefault(primary)
            btn.clicked.connect(lambda _c=False, f=cb: f())
            lay.addWidget(btn, 0, Qt.AlignVCenter)

    def page_services(self):
        p = Page("Services")
        g = p.group()
        user = os.environ.get("USER", "")
        for key, unit, title, desc in SERVICES:
            on = unit_state(unit) == "active"
            installed = shutil.which(SERVICE_BIN[key]) is not None
            sub = f"{status_text(on, installed)} · {_(desc)}"
            if key == "vpn" and on:
                ip = sh_out("tailscale", "ip", "-4").strip()
                if ip:
                    sub = f"{_('Running')} · {_('Address from anywhere: {}').format(ip)}"
            lay = g.row(title, sub, app_icon(SERVICE_ICONS[key]))
            if on:
                self._buttons(lay, [("Logs", lambda u=unit: Logs(self, u).exec(), False),
                                    ("Stop", lambda k=key, t=title: self.run_helper(_(t), ["service-off", k]), False)])
            else:
                self._buttons(lay, [("Turn on" if installed else "Install",
                                     lambda k=key, t=title: self.run_helper(_(t), ["service-on", k, user]), True)])
        lg = p.group()
        lg.action("Whole system log", "journalctl", "Show", lambda: in_terminal("journalctl", "-e"))
        return p

    def page_templates(self):
        p = Page("Ready-made servers")
        root = Path("/usr/share/nebulaos/templates")
        names = [n for n in TEMPLATES if (root / n).is_dir()]
        ip = local_ip()
        listening = sh_out("ss", "-Htln")
        user = os.environ.get("USER", "")
        mine, other = p.group("Installed"), p.group("Available")
        for name in names:
            title, desc, icons, port, path = TEMPLATES[name]
            installed = Path(f"/srv/nebula/{name}/compose.yaml").exists()
            running = installed and f":{port} " in listening
            if not installed:
                lay = other.row(title, _(desc), app_icon(icons))
                self._buttons(lay, [("Install", lambda n=name, t=title: self.deploy(n, t, user), False)])
                continue
            where = f"http://{ip}:{port}" if path is not None else f"{ip}:{port}"
            lay = mine.row(title, f"{status_text(running, True)} · {where}", app_icon(icons))
            btns = []
            if running and path is not None:
                btns.append(("Open", lambda pt=port, pa=path: subprocess.Popen(
                    ["xdg-open", f"http://localhost:{pt}{pa}"]), True))
            btns.append(("Stop" if running else "Start",
                         lambda n=name, t=title, r=running: self.run_helper(_(t), ["stop" if r else "start", n]), False))
            btns.append(("Remove", lambda n=name, t=title: self.remove_server(n, t), False))
            self._buttons(lay, btns)
        for grp in (mine, other):
            if grp.rows.count() <= 1:
                grp.hide()
        return p

    def deploy(self, name, title, user):
        args = ["deploy", name, user]
        if name == "minecraft":
            if QMessageBox.question(self, _(title), _("Minecraft needs you to accept its EULA "
                                                      "(aka.ms/MinecraftEULA). Accept?")) != QMessageBox.Yes:
                return
            args.append("--accept-eula")
        self.run_helper(_(title), args)

    def remove_server(self, name, title):
        if QMessageBox.question(self, _(title), _("Remove {}? Its data stays in /srv/nebula.").format(_(title))) \
                == QMessageBox.Yes:
            self.run_helper(_(title), ["remove", name])

    def page_firewall(self):
        p = Page("Firewall")
        g = p.group()
        on = unit_state("ufw") == "active"
        g.switch("Firewall", "Block incoming connections except open services", on,
                 lambda en: in_terminal("nebula", "server", "firewall") if en else in_terminal("sudo", "ufw", "disable"))
        rules = p.group("Rules")
        out = subprocess.run(["sudo", "-n", "ufw", "status"], capture_output=True, text=True).stdout
        lines = [l for l in out.splitlines()[4:] if l.strip()]
        if lines:
            for l in lines[:30]:
                rules.widget(QLabel(" ".join(l.split())))
        else:
            rules.action("Rules", "", "Show", lambda: in_terminal("sudo", "ufw", "status", "numbered"))
        return p


def main():
    a = app("nebula-serverpanel", "network-server")
    w = Panel()
    w.show()
    return a.exec()


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Game Center (Gaming mode), in the spirit of Steam Big Picture.

A large banner of the selected game (Steam's hero art), Play button, size on disk,
a row of covers below; tabs for Boost (turbo, power profile, FPS overlay) and
Launchers (Heroic, Lutris, Bottles…).
"""
import re
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/nebulaos")
from nebula_qt import _, Page, app, fit, in_terminal, run  # noqa: E402
from PySide6.QtCore import Qt  # noqa: E402
from PySide6.QtGui import QColor, QLinearGradient, QPainter, QPixmap  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QButtonGroup, QFrame, QGridLayout, QHBoxLayout, QLabel, QMainWindow, QPushButton, QScrollArea,
    QStackedWidget, QVBoxLayout, QWidget,
)

HOME = Path.home()
STEAM_ROOTS = [HOME / ".local/share/Steam", HOME / ".steam/steam",
               HOME / ".var/app/com.valvesoftware.Steam/.local/share/Steam"]
NOT_GAMES = re.compile(r"Proton|Steamworks|Steam Linux Runtime|SteamVR|Redistributable", re.I)


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PB"


def art(root, appid, kind):
    cache = root / "appcache/librarycache"
    names = {"cover": ["library_600x900.jpg", "library_600x900_2x.jpg"], "hero": ["library_hero.jpg"],
             "logo": ["logo.png"]}[kind]
    for n in names:
        for p in (cache / f"{appid}_{n}", cache / appid / n):
            if p.exists():
                return str(p)
    return None


def steam_library():
    games, seen = [], set()
    for root in STEAM_ROOTS:
        folders = [root / "steamapps"]
        vdf = root / "steamapps/libraryfolders.vdf"
        if vdf.exists():
            folders += [Path(p) / "steamapps" for p in re.findall(r'"path"\s+"([^"]+)"', vdf.read_text(errors="ignore"))]
        for folder in folders:
            for acf in folder.glob("appmanifest_*.acf"):
                text = acf.read_text(errors="ignore")
                get = lambda k: (re.search(rf'"{k}"\s+"([^"]*)"', text) or [None, ""])[1]  # noqa: E731
                appid, name = get("appid"), get("name")
                if not appid or not name or appid in seen or NOT_GAMES.search(name):
                    continue
                seen.add(appid)
                games.append({"appid": appid, "name": name, "size": int(get("SizeOnDisk") or 0),
                              "cover": art(root, appid, "cover"), "hero": art(root, appid, "hero"),
                              "logo": art(root, appid, "logo")})
    return sorted(games, key=lambda g: g["name"].lower())


def play(game):
    subprocess.Popen(["xdg-open", f"steam://rungameid/{game['appid']}"])


class Hero(QWidget):
    """The big banner: hero art fading into the window color, title or logo, Play."""

    def __init__(self):
        super().__init__()
        self.setMinimumHeight(340)
        self.pix = None
        v = QVBoxLayout(self)
        v.setContentsMargins(36, 0, 36, 28)
        v.addStretch(1)
        self.logo = QLabel()
        self.title = QLabel()
        f = self.title.font()
        f.setPointSizeF(f.pointSizeF() * 2.4)
        f.setBold(True)
        self.title.setFont(f)
        self.title.setStyleSheet("color: white;")
        self.meta = QLabel()
        self.meta.setStyleSheet("color: rgba(255,255,255,0.75);")
        row = QHBoxLayout()
        self.play_btn = QPushButton("▶  " + _("Play"))
        self.play_btn.setDefault(True)
        self.play_btn.setMinimumSize(150, 42)
        f2 = self.play_btn.font()
        f2.setPointSizeF(f2.pointSizeF() * 1.15)
        f2.setBold(True)
        self.play_btn.setFont(f2)
        row.addWidget(self.play_btn)
        row.addSpacing(16)
        row.addWidget(self.meta)
        row.addStretch(1)
        v.addWidget(self.logo)
        v.addWidget(self.title)
        v.addSpacing(10)
        v.addLayout(row)

    def show_game(self, game):
        self.pix = QPixmap(game["hero"]) if game.get("hero") else None
        if game.get("logo"):
            self.logo.setPixmap(QPixmap(game["logo"]).scaled(420, 120, Qt.KeepAspectRatio, Qt.SmoothTransformation))
            self.logo.show()
            self.title.hide()
        else:
            self.logo.hide()
            self.title.setText(game["name"])
            self.title.show()
        self.meta.setText(_("On disk: {}").format(human(game["size"])) if game["size"] else "")
        self.update()

    def paintEvent(self, _e):
        p = QPainter(self)
        r = self.rect()
        if self.pix and not self.pix.isNull():
            scaled = self.pix.scaled(r.size(), Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
            p.drawPixmap(r.x() - (scaled.width() - r.width()) // 2, 0, scaled)
        else:
            g = QLinearGradient(0, 0, r.width(), r.height())
            g.setColorAt(0, QColor("#3a0a0e"))
            g.setColorAt(1, QColor("#0d0d10"))
            p.fillRect(r, g)
        fade = QLinearGradient(0, r.height() * 0.35, 0, r.height())
        base = self.palette().window().color()
        clear = QColor(base)
        clear.setAlpha(0)
        fade.setColorAt(0, clear)
        fade.setColorAt(1, base)
        p.fillRect(r, fade)
        p.end()


class Cover(QLabel):
    def __init__(self, center, game):
        super().__init__()
        self.center, self.game = center, game
        self.setFixedSize(150, 225)
        self.setCursor(Qt.PointingHandCursor)
        self.setAlignment(Qt.AlignCenter)
        self.setWordWrap(True)
        if game.get("cover"):
            self.setPixmap(QPixmap(game["cover"]).scaled(150, 225, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation))
        else:
            self.setText(game["name"])
        self.select(False)

    def select(self, on):
        border = "3px solid palette(highlight)" if on else "3px solid transparent"
        self.setStyleSheet(f"QLabel {{ border: {border}; border-radius: 8px; background: palette(base); }}")

    def mousePressEvent(self, _e):
        self.center.choose(self)

    def mouseDoubleClickEvent(self, _e):
        play(self.game)


class Games(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(_("Game Center"))
        self.games = steam_library()
        self.current = None

        tabs = QHBoxLayout()
        tabs.setContentsMargins(24, 14, 24, 8)
        self.tab_group = QButtonGroup(self)
        for i, name in enumerate(("Library", "Boost", "Launchers")):
            b = QPushButton(_(name))
            b.setCheckable(True)
            b.setChecked(i == 0)
            b.setMinimumWidth(130)
            self.tab_group.addButton(b, i)
            tabs.addWidget(b)
        tabs.addStretch(1)
        steam = QPushButton(_("Open Steam"))
        steam.setFlat(True)
        steam.clicked.connect(lambda: subprocess.Popen(["xdg-open", "steam://open/games"]))
        tabs.addWidget(steam)

        self.stack = QStackedWidget()
        self.stack.addWidget(self.library())
        self.stack.addWidget(self.boost())
        self.stack.addWidget(self.launchers())
        self.tab_group.idClicked.connect(self.stack.setCurrentIndex)

        body = QWidget()
        v = QVBoxLayout(body)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(0)
        v.addLayout(tabs)
        v.addWidget(self.stack, 1)
        self.setCentralWidget(body)
        fit(self, 1240, 780)

    # ---------- Library ----------
    def library(self):
        page = QWidget()
        v = QVBoxLayout(page)
        v.setContentsMargins(0, 0, 0, 0)
        if not self.games:
            empty = Page("Library", "Install Steam and a game; they appear here")
            g = empty.group()
            g.action("Steam", "", "App Store", lambda: subprocess.Popen(["nebula-store"]), primary=True)
            v.addWidget(empty)
            return page
        self.hero = Hero()
        self.hero.play_btn.clicked.connect(lambda: self.current and play(self.current.game))
        v.addWidget(self.hero)
        label = QLabel(_("Your games") + f"  ·  {len(self.games)}")
        f = label.font()
        f.setBold(True)
        label.setFont(f)
        label.setContentsMargins(36, 0, 0, 0)
        v.addWidget(label)
        host = QWidget()
        grid = QGridLayout(host)
        grid.setContentsMargins(36, 8, 36, 24)
        grid.setSpacing(14)
        self.covers = [Cover(self, g) for g in self.games]
        for i, c in enumerate(self.covers):
            grid.addWidget(c, i // 7, i % 7, Qt.AlignLeft)
        grid.setColumnStretch(7, 1)
        grid.setRowStretch(len(self.covers) // 7 + 1, 1)
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setWidget(host)
        v.addWidget(scroll, 1)
        self.choose(self.covers[0])
        return page

    def choose(self, cover):
        if self.current:
            self.current.select(False)
        self.current = cover
        cover.select(True)
        self.hero.show_game(cover.game)

    # ---------- Boost ----------
    def boost(self):
        p = Page("Boost")
        g = p.group()
        g.action("Turbo mode", "Turns off desktop effects while you play", "Toggle", lambda: run("perf"))
        profiles = ["power-saver", "balanced", "performance"]
        names = ["Power saver", "Balanced", "Performance"]
        cur = run("power", "get")[1].strip()
        g.combo("Power profile", names, profiles.index(cur) if cur in profiles else 1,
                lambda i: run("power", profiles[i]))
        mango = (HOME / ".config/environment.d/90-mangohud.conf").exists()
        g.switch("FPS counter in games (MangoHud)", "After re-login. Hide in a game: Shift_R+F12", mango,
                 lambda on: run("game", "mangohud", "on" if on else "off"))
        g.switch("Switch to Gaming mode when a game starts", "", "on" in run("automode", "status")[1],
                 lambda on: run("automode", "on" if on else "off"))
        d = p.group("Drivers")
        d.action("Graphics drivers", "NVIDIA, AMD or Intel", "Check", lambda: in_terminal("nebula", "drivers"))
        return p

    # ---------- Launchers ----------
    def launchers(self):
        p = Page("Launchers")
        g = p.group()
        has_flatpak = shutil.which("flatpak") is not None
        for name, desc, flat in (("Steam", "", "com.valvesoftware.Steam"),
                                 ("Heroic", "Epic Games, GOG, Amazon", "com.heroicgameslauncher.hgl"),
                                 ("Lutris", "All games in one place", "net.lutris.Lutris"),
                                 ("Bottles", "Windows programs", "com.usebottles.bottles"),
                                 ("Prism Launcher", "Minecraft", "org.prismlauncher.PrismLauncher"),
                                 ("ProtonUp-Qt", "Proton-GE and Wine-GE", "net.davidotek.pupgui2")):
            installed = has_flatpak and subprocess.run(["flatpak", "info", flat], capture_output=True).returncode == 0
            if installed:
                g.action(name, desc, "Open", lambda f=flat: subprocess.Popen(["flatpak", "run", f]))
            else:
                g.action(name, desc, "Get", lambda: subprocess.Popen(["nebula-store"]))
        return p


def main():
    a = app("nebula-games", "input-gaming")
    w = Games()
    w.show()
    return a.exec()


if __name__ == "__main__":
    sys.exit(main())

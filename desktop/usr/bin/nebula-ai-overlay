#!/usr/bin/env python3
"""NebulaOS AI assistant window (Super+A), native Qt.

Chat with the local model. When it proposes a command, a card with Run/Skip appears:
nothing runs until you press Run. The output goes back to the assistant so it can
continue. sudo and risky commands open in a terminal.
"""
import importlib.machinery
import importlib.util
import shlex
import subprocess
import sys

sys.path.insert(0, "/usr/lib/nebulaos")
from nebula_qt import _, app, background, fit  # noqa: E402
from PySide6.QtCore import Qt, QTimer  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QFrame, QHBoxLayout, QLabel, QLineEdit, QPushButton, QScrollArea, QVBoxLayout, QWidget,
)

# The assistant logic lives in /usr/bin/ai (a script without .py) — load it as a module.
_loader = importlib.machinery.SourceFileLoader("nebula_ai", "/usr/bin/ai")
_spec = importlib.util.spec_from_loader("nebula_ai", _loader)
ai = importlib.util.module_from_spec(_spec)
_loader.exec_module(ai)

BUBBLE = {
    "user": "background: palette(highlight); color: palette(highlighted-text); border-radius: 14px; padding: 9px 13px;",
    "bot": "background: palette(base); border: 1px solid palette(midlight); border-radius: 14px; padding: 9px 13px;",
    "cmd": "background: palette(alternate-base); border-radius: 10px; padding: 8px 10px; font-family: monospace;",
}


class Assistant(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(_("Assistant"))
        self.messages = None
        self.steps = 0

        self.list = QVBoxLayout()
        self.list.setSpacing(10)
        self.list.addStretch(1)
        host = QWidget()
        host.setLayout(self.list)
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.NoFrame)
        self.scroll.setWidget(host)

        self.entry = QLineEdit()
        self.entry.setPlaceholderText(_("Your question…  (Enter to send)"))
        self.entry.setMinimumHeight(34)
        self.entry.returnPressed.connect(self.send)
        self.busy_label = QLabel("")
        self.busy_label.setStyleSheet("color: palette(placeholder-text);")
        bottom = QHBoxLayout()
        bottom.addWidget(self.entry, 1)
        bottom.addWidget(self.busy_label)

        lay = QVBoxLayout(self)
        lay.setContentsMargins(14, 14, 14, 14)
        lay.addWidget(self.scroll, 1)
        lay.addLayout(bottom)
        self.bubble("bot", _("Ask anything about your system, an error or code. Esc closes.\n").strip() + "\n"
                    + _("I can also run commands for you — each one only after you press Run."))
        self._dots = 0
        self._timer = QTimer(self)
        self._timer.timeout.connect(self.tick)
        fit(self, 760, 560)

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.close()
        super().keyPressEvent(event)

    # ---------- Rendering ----------
    def add(self, widget, align=None):
        row = QHBoxLayout()
        if align == "right":
            row.addStretch(1)
        row.addWidget(widget, 0 if align else 1)
        if align == "left":
            row.addStretch(1)
        self.list.insertLayout(self.list.count() - 1, row)
        QTimer.singleShot(50, lambda: self.scroll.verticalScrollBar().setValue(self.scroll.verticalScrollBar().maximum()))

    def bubble(self, who, text):
        label = QLabel(ai.RUN_BLOCK.sub("", text).strip() or "…")
        label.setWordWrap(True)
        label.setTextInteractionFlags(Qt.TextSelectableByMouse)
        label.setStyleSheet(BUBBLE[who])
        # Width follows the text (like a chat app), capped so long answers wrap nicely.
        longest = max((label.fontMetrics().horizontalAdvance(line) for line in label.text().splitlines()), default=0)
        label.setMinimumWidth(min(560, longest + 32))
        label.setMaximumWidth(600)
        self.add(label, "right" if who == "user" else "left")

    def command_card(self, cmd):
        card = QFrame()
        card.setObjectName("group")
        v = QVBoxLayout(card)
        v.setContentsMargins(12, 10, 12, 10)
        code = QLabel(cmd)
        code.setWordWrap(True)
        code.setTextInteractionFlags(Qt.TextSelectableByMouse)
        code.setStyleSheet(BUBBLE["cmd"])
        v.addWidget(code)
        if ai.is_dangerous(cmd):
            warn = QLabel("⚠ " + _("Potentially destructive — check it carefully."))
            warn.setStyleSheet("color: #f87171;")
            v.addWidget(warn)
        row = QHBoxLayout()
        run_btn = QPushButton(_("Run"))
        run_btn.setDefault(True)
        skip = QPushButton(_("Skip"))
        row.addStretch(1)
        row.addWidget(skip)
        row.addWidget(run_btn)
        v.addLayout(row)
        run_btn.clicked.connect(lambda: self.on_run(cmd, run_btn, skip))
        skip.clicked.connect(lambda: self.on_skip(cmd, run_btn, skip))
        self.add(card)

    def busy(self, on):
        self.entry.setEnabled(not on)
        if on:
            self._timer.start(350)
        else:
            self._timer.stop()
            self.busy_label.setText("")
            self.entry.setFocus()

    def tick(self):
        self._dots = (self._dots + 1) % 4
        self.busy_label.setText("•" * self._dots)

    # ---------- Conversation ----------
    def send(self):
        text = self.entry.text().strip()
        if not text:
            return
        self.entry.clear()
        if self.messages is None:
            self.messages = ai.new_conversation()
        self.messages.append({"role": "user", "content": text})
        self.bubble("user", text)
        self.steps = 0
        self.ask()

    def ask(self):
        self.busy(True)
        background(lambda: ai.chat(self.messages), self.answered)

    def answered(self, reply):
        self.busy(False)
        if isinstance(reply, Exception):
            self.bubble("bot", _("Error: {}").format(reply))
            return
        self.messages.append({"role": "assistant", "content": reply})
        self.bubble("bot", reply)
        for cmd in ai.commands_in(reply):
            self.command_card(cmd)

    def on_skip(self, cmd, *buttons):
        for b in buttons:
            b.setEnabled(False)
        self.messages.append({"role": "user", "content": f"I chose not to run `{cmd}`."})

    def on_run(self, cmd, *buttons):
        for b in buttons:
            b.setEnabled(False)
        if ai.needs_terminal(cmd):
            done = shlex.quote(_("Done. Press Enter to close."))
            subprocess.Popen(["nebula", "term", "-e", "bash", "-c", f"{cmd}; echo; printf '%s' {done}; read _"])
            self.messages.append({"role": "user", "content": f"I ran `{cmd}` in a terminal."})
            return
        self.busy(True)
        background(lambda: ai.run_captured(cmd), lambda r, c=cmd: self.ran(c, r))

    def ran(self, cmd, result):
        self.busy(False)
        code, out = result if isinstance(result, tuple) else (1, str(result))
        label = QLabel((out.strip() or _("(no output)"))[-2000:])
        label.setWordWrap(True)
        label.setTextInteractionFlags(Qt.TextSelectableByMouse)
        label.setStyleSheet(BUBBLE["cmd"])
        self.add(label)
        self.messages.append(ai.feedback(cmd, code, out))
        self.steps += 1
        if self.steps < ai.MAX_STEPS:
            self.ask()       # let the assistant continue with the result


def main():
    a = app("nebula-ai", "nebula-assistant")
    w = Assistant()
    w.show()
    if "--ask" in sys.argv and sys.argv.index("--ask") + 1 < len(sys.argv):   # question from Spotlight
        w.entry.setText(sys.argv[sys.argv.index("--ask") + 1])
        QTimer.singleShot(200, w.send)
    return a.exec()


if __name__ == "__main__":
    sys.exit(main())
